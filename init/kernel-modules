# pk's OS :: kernel modules to place in the initramfs (top-level names).
# The build script derives their full dependency closure via `modprobe --show-depends`,
# then decompresses .ko.xz/.zst and stores them in order as /mods/NN-name.ko.
# A module built into the kernel (=y) is skipped automatically.

# --- must-haves for boot / root mount
loop
squashfs
overlay
ext4
isofs
udf
vfat
fat

# --- compression (for squashfs)
zlib
zlib_deflate
zstd_decompress
lz4_decompress
lzo_decompress

# --- filesystems that may show up on live/USB (ntfs3/btrfs/xfs get modprobed in live)
exfat

# --- block / storage
sd_mod
sr_mod
ata_piix
libata
ahci
ata_generic
nvme
nvme-core
usb-storage
uas
virtio_blk
virtio_pci
virtio_mmio
mmc_block

# --- usb host controllers
xhci-hcd
ehci-pci
ehci-platform
ohci-pci
ohci-platform
uhci-hcd

# --- keyboard / mouse
i8042
atkbd
mousedev
usbhid
hid_generic

# --- NO network here ON PURPOSE: the initramfs needs no net to find disks
# at all. NIC drivers live in the live rootfs /lib/modules (slower but the
# right place) and come via modprobe there. Putting net drivers here makes the initrd
# ~4MB heavier and boot ~1s slower - zero benefit.

# --- filesystem runtime deps: modules.dep does not list them, hence explicit ---
# (without these, 'mount -t vfat' fails in the initramfs -> an image on a FAT32/exFAT pendrive boots
#  never; ntfs3 reads ISO/frugal images kept on Windows partitions)
nls_cp437
nls_utf8
msdos
unicode
ntfs3
crc_itu_t
