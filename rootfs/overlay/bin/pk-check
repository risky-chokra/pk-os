#!/bin/sh
# pk's OS :: ek command me poora health + hardware check
#   pk-check              boot, net, runtime, apps, disk, USB, display, KVM, Secure Boot...
#   pk-check --verbose    har check ka detail
#   pk-check --save       report /run/pk/check.txt (+ /tmp/pk-check.txt) me likho
#   pk-check --apps       app battery bhi chala do (pk-run --selftest)
#   pk-check --gui        Xvfb/weston utha ke ek X client se display test karo
#   pk-check --speed      disk write speed (pendrive pe khaali jagah me 64 MB)
#
# Real PC / pendrive test ke liye bana: sab kuch PASS dikhaye to image + hardware
# dono theek hain. Kuch FAIL ho to `pk-check --save` ki file hi bhej dena.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
VERB=0 SAVE=0 DOAPPS=0 DOGUI=0 DOSPEED=0 DOUN=0
for a in "$@"; do
  case "$a" in
    --verbose|-v) VERB=1 ;;
    --save)       SAVE=1 ;;
    --apps)       DOAPPS=1 ;;
    --gui)        DOGUI=1 ;;
    --speed)      DOSPEED=1 ;;
    --users)      DOUN=1 ;;
    --all)        VERB=1; SAVE=1; DOAPPS=1; DOGUI=1; DOSPEED=1; DOUN=1 ;;
    --help|-h)    sed -n '2,12p' "$0"; exit 0 ;;
  esac
done

RT=${PK_RUNTIME_ROOT:-/opt/pk}
pass_n=0; fail_n=0; warn_n=0; info_n=0
REP=/run/pk/check.txt
ROWS=/run/pk/check.rows
mkdir -p /run/pk 2>/dev/null
: > "$ROWS" 2>/dev/null

row() { # <ok|fail|warn|info> <name> <detail>
  st=$1; name=$2; det=${3:-}
  case "$st" in
    ok)   pass_n=$((pass_n + 1)); p='[ok  ]' ;;
    fail) fail_n=$((fail_n + 1)); p='[FAIL]' ;;
    warn) warn_n=$((warn_n + 1)); p='[warn]' ;;
    *)    info_n=$((info_n + 1)); p='[info]' ;;
  esac
  line=$(printf '%-6s %-13s %s' "$p" "$name" "$det")
  printf '%s\n' "$line"
  printf '%s\n' "$line" >> "$ROWS" 2>/dev/null
}

have() { command -v "$1" >/dev/null 2>&1; }
mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }

# ------------------------------------------------------------------ system
row info system "$(uname -s) $(uname -r) $(uname -m) | $(cat /etc/os-release 2>/dev/null | sed -n 's/^PRETTY_NAME=//p' | tr -d '"')"

mode=$(cat /run/pk/mode 2>/dev/null)
[ -n "$mode" ] || mode=$(sed -n 's/^BOOTMODE=//p' /run/pk/boot.env 2>/dev/null | head -1)
if [ -n "$mode" ]; then
  row ok boot "mode=$mode  media=$(cat /run/pk/media 2>/dev/null || echo '?')"
else
  row warn boot "/run/pk/mode nahi mila (pk-boot chala? init: $(cat /proc/1/comm 2>/dev/null))"
fi
if [ -r /run/pk/boot.env ]; then row ok bootenv "$(tr '\n' ' ' < /run/pk/boot.env | cut -c1-120)"; else row warn bootenv "/run/pk/boot.env nahi mila (pk-boot chala?)"; fi

# root writable? (overlay upper)
if touch /run/pk/.wtest 2>/dev/null; then rm -f /run/pk/.wtest; row ok writable "/ writable hai"; else row fail writable "/ read-only hai"; fi
up=$(awk '$2=="/"{print $4}' /proc/mounts 2>/dev/null | head -1)
case "$up" in
  *upperdir=/mnt/persist*) row ok persist "upper=/mnt/persist (USB pe save hota hai)" ;;
  *upperdir=*)             row info persist "upper=RAM (reboot pe reset) - 'persistent' boot option use karo" ;;
  ext4|ext2)               row ok persist "installed ext4 root (changes save)" ;;
  *)                       row info persist "root fs: ${up:-?}" ;;
esac

# ------------------------------------------------------------------ hardware
cpu=$(sed -n 's/^model name[ ]*:[ ]*//p' /proc/cpuinfo 2>/dev/null | head -1)
row info cpu "${cpu:-x86_64} ($(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo ?) threads)"
memtot=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
memavl=$(awk '/MemAvailable/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
row info mem "${memtot:-?} MB total / ${memavl:-?} MB free"
if [ -e /dev/kvm ]; then row ok kvm "/dev/kvm (QEMU hardware accel chalega)"; else row info kvm "/dev/kvm nahi (pk-vm TCG se chalega, dheema)"; fi

# USB speed of the boot device (pendrive test ka main point)
spd=''
if [ -d /sys/bus/usb/devices ]; then
  for d in /sys/bus/usb/devices/*/speed; do
    [ -r "$d" ] || continue
    v=$(cat "$d" 2>/dev/null)
    [ -n "$v" ] && spd="$spd $(printf '%s' "$(basename "$(dirname "$d")")")=$v"
  done
fi
if [ -n "$spd" ]; then
  case " $spd " in
    *" 5000000000 "*|*" 10000000000 "*|*" 20000000000 "*) row ok usb "super speed (USB3):$spd" ;;
    *" 480000000 "*)                                         row ok usb "high speed (USB2):$spd" ;;
    *" 12000000 "*)                                          row warn usb "full speed (USB1, 12 Mb) - boot/USB apps bahut dheeme: $spd" ;;
    *)                                                        row info usb "usb devices:$spd" ;;
  esac
else
  row info usb "koi USB device speed file nahi (toram? ya USB boot nahi)"
fi

# disks
disks=''
for d in /sys/block/*; do
  n=${d##*/}
  case "$n" in loop*|ram*|zram*) continue ;; esac
  szb=$(cat "$d/size" 2>/dev/null || echo 0)
  gb=$(( szb / 2097152 ))   # 512-byte sectors -> GiB
  ro=''
  [ -w "/dev/$n" ] || ro=' (ro)'
  disks="$disks $n=${gb}G$ro"
done
row info disks "${disks:- koi block dev nahi}"
if [ "$DOSPEED" = 1 ]; then
  t=/var/tmp/pk-speed.$$
  s=$( ( dd if=/dev/zero of="$t" bs=1M count=64 2>&1; sync ) 2>/dev/null | tail -2 | tr '\n' ' ' )
  rm -f "$t" 2>/dev/null
  rate=$(printf '%s' "$s" | sed -n 's/.* \([0-9.]*\) [MG]B.s.*/\1/p' | head -1)
  unit=$(printf '%s' "$s" | sed -n 's/.*[0-9.]* \([MG]\)B.s.*/\1/p' | head -1)
  if [ -n "$rate" ]; then row ok speed "write ${rate} ${unit}B/s (fsync, 64 MB)"; else row warn speed "speed test fail (fs read-only?)"; fi
fi

# ------------------------------------------------------------------ display
if [ -e /dev/fb0 ]; then row ok fb "/dev/fb0 (framebuffer)"; else row info fb "/dev/fb0 nahi (GUI ke liye DRM/Xvfb use hoga)"; fi
drm=''
for c in /dev/dri/card*; do [ -e "$c" ] && drm="$drm $c"; done
for c in /dev/dri/renderD128*; do [ -e "$c" ] && drm="$drm $c"; done
if [ -n "$drm" ]; then row ok drm "KMS devices:$drm (weston KMS backend chalega)"; else row info drm "/dev/dri nahi (weston ko headless/Xvfb chahiye)"; fi
# ---- I/O devices + session manager (audio/input/serial/seatd) --------------------
if [ -S "$RT/run/seatd.sock" ]; then
  row ok seatd "seatd chalu ($RT/run/seatd.sock) - weston ko VT+DRM+input isi se milta hai"
elif [ -x /usr/bin/pk-seatd ]; then
  row info seatd "seatd band -> 'pk-seatd start' (weston bina session manager ke headless par gir sakta hai)"
fi
sndn=$(ls /dev/snd/pcmC*D*p 2>/dev/null | wc -l | tr -d ' ')
if [ -n "$sndn" ] && [ "$sndn" != 0 ]; then
  row ok audio "/dev/snd: $sndn pcm node (group=$(ls -l /dev/snd/pcmC0D0p 2>/dev/null | awk '{print $4}' | head -1)) - users ko audio group me rakha hai"
elif [ -d /dev/snd ]; then
  row info audio "/dev/snd hai par pcm node nahi (codec bind nahi hua? 'dmesg | grep -i snd' dekho)"
else
  row info audio "sound card nahi mila (live me snd-hda-intel, snd-usb-audio, snd-ac97 ship hote hain)"
fi
inp=$(ls /dev/input/event* 2>/dev/null | wc -l | tr -d ' ')
if [ -n "$inp" ] && [ "$inp" != 0 ]; then
  row ok input "$inp event devices (group=$(ls -l /dev/input/event0 2>/dev/null | awk '{print $4}' | head -1); mdev.conf se 0660)"
else
  row info input "/dev/input/event* nahi (PS/2 hidpi? 'dmesg | grep -i input' dekho)"
fi
ser=$(ls /dev/ttyS* /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | wc -l | tr -d ' ')
[ -n "$ser" ] && [ "$ser" != 0 ] && row ok serial "$ser serial nodes (ttyS/ttyUSB/ttyACM; dialout group)"
cam=$(ls /dev/video* 2>/dev/null | wc -l | tr -d ' ')
[ -n "$cam" ] && [ "$cam" != 0 ] && row ok webcam "$cam /dev/video* (uvc)"
if [ -f /run/pk/x-how ]; then
  row ok desktop "$(cat /run/pk/x-how 2>/dev/null)"
else
  row info desktop "desktop session nahi chala (GRUB entry 5 / boot option pk_desktop=1 se chalu hota hai)"
fi
# ---- users: add/remove kaam karta hai? (--users se full round-trip) ----------------
nu=$(awk -F: '$3>=1000' /etc/passwd 2>/dev/null | wc -l | tr -d ' ')
au=$(sed -n 's/^PK_CONSOLE_AUTOLOGIN=//p' /etc/pk-console.conf 2>/dev/null | head -1)
[ -f /run/pk/autologin ] && au=$(cat /run/pk/autologin 2>/dev/null)
row ok users "${nu:-0} normal user(s), autologin=${au:-off} (pk-user list / pk-user add <n})"
if [ "$DOUN" = 1 ]; then
  tu=pkq$$
  if pk-user add "$tu" --password=pk >/run/pk/user-test.log 2>&1; then
    idout=$(su -m "$tu" -c 'id' 2>&1 | head -1)
    if printf '%s' "$idout" | grep -q "uid=$(id -u "$tu" 2>/dev/null || echo x)"; then
      pk-user del "$tu" --home >/dev/null 2>&1
      if ! grep -qs "^$tu:" /etc/passwd; then
        row ok useradd "round-trip OK: add -> su ('$idout') -> del"
      else
        row fail useradd "del fail: $tu /etc/passwd me bacha hua"
      fi
    else
      pk-user del "$tu" --home >/dev/null 2>&1
      row fail useradd "su fail: $idout"
    fi
  else
    row fail useradd "pk-user add fail (log: /run/pk/user-test.log)"
  fi
fi
# "screen kaali" diagnosis: fb blank flag + backlight power/brightness
fbb=''
for f in /sys/class/graphics/fb*; do
  [ -e "$f/blank" ] || continue
  fbb="$fbb ${f##*/}=$(cat "$f/blank" 2>/dev/null)"
done
bl=''
for b in /sys/class/backlight/*; do
  [ -d "$b" ] || continue
  cur=$(cat "$b/brightness" 2>/dev/null); mx=$(cat "$b/max_brightness" 2>/dev/null); pwr=$(cat "$b/bl_power" 2>/dev/null)
  bl="$bl ${b##*/}:brightness=${cur:-?}/${mx:-?} power=${pwr:-?}"
done
if [ -n "$bl" ]; then
  case "$bl" in
    *power=1*) row warn backlight "backlight OFF ($bl) - kaali screen ka asli karan ho sakta hai; S08display boot par ise on karta hai" ;;
    *) row ok backlight "on ($bl)" ;;
  esac
else
  row info backlight "koi /sys/class/backlight nahi (desktop/VM - panel ki roshni BIOS/host ke paas hai)"
fi
case "$fbb" in
  *="1"*|*" 1"*) row warn fb-blank "framebuffer blanked:$fbb - fix: echo 0 > /sys/class/graphics/fb*/blank (boot par S08display karta hai), consoleblank=0 default set hai";;
  *) row info fb-blank "blank flags:${fbb:- (no fb)} | screen console: $(awk '{print $1}' /proc/consoles 2>/dev/null | tr '\n' ' ') | GRUB: v=nomodeset, b=nomodeset+serial";;
esac
if [ -f /run/pk/display.txt ]; then row info display-status "$(cat /run/pk/display.txt 2>/dev/null)"; fi
if [ "$DOGUI" = 1 ]; then
  rt_has() { for d in "$RT/usr/bin" "$RT/usr/local/bin" "$RT/bin"; do
               { [ -x "$d/$1" ] || [ -e "$d/$1" ] || [ -L "$d/$1" ]; } && return 0
             done; return 1; }
  if command -v pk-x >/dev/null 2>&1; then
    sess_prev=0
    if [ -r /run/pk/x-env ] && { [ -e "$RT/run/pk-x/wayland-1" ] || [ -e "$RT/tmp/.X11-unix/X0" ] || [ -e /tmp/.X11-unix/X0 ]; }; then
      sess_prev=1
    else
      pk-x start > /run/pk/gui-start.log 2>&1
    fi
    rc=$?
    [ -r /run/pk/x-env ] && . /run/pk/x-env
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
      ( printf '### PK: GUI-X-OK (%s) ###\n' "${DISPLAY:-${WAYLAND_DISPLAY:-wayland}}" > /dev/console ) 2>/dev/null
      row ok display "DISPLAY=${DISPLAY:-none} WAYLAND=${WAYLAND_DISPLAY:-none} (rc=$rc${sess_prev:+, session pehle se tha})"
      # weston ke andar XWayland ho to :0 pe X clients chal sakte hain
      xd=${DISPLAY:-}
      if [ -z "$xd" ] && [ -e "$RT/tmp/.X11-unix/X0" ]; then xd=":0"; row info xwayland "XWayland socket mila ($RT/tmp/.X11-unix/X0)"; fi
      if [ -n "$xd" ] && rt_has xdpyinfo; then
        out=$(DISPLAY="$xd" pk-run --gui xdpyinfo 2>&1 | sed -n '2p' | tr '\n' ' ' | cut -c1-70)
        if [ -n "$out" ]; then
          row ok xclient "xdpyinfo ($xd): $out"
          ( printf '### PK: GUI-XCLIENT-OK ###\n' > /dev/console ) 2>/dev/null
        else
          row warn xclient "xdpyinfo ne output nahi diya (X server ready ho sakta hai, client fail)"
        fi
      fi
      # ek asli GUI client: xterm (X11) ya weston-terminal (Wayland)
      if [ -n "$xd" ] && rt_has xterm; then
        if DISPLAY="$xd" pk-run --gui xterm -e /bin/sh -c "echo PK-GUI-APP-RAN" >/dev/null 2>&1; then
          row ok guiapp "xterm -e (X11 client) chala ✓"
          ( printf '### PK: GUI-APP-OK (xterm) ###\n' > /dev/console ) 2>/dev/null
        else
          row fail guiapp "xterm rc!=0 (detail: /run/pk/x.log)"
          ( printf '### PK: GUI-APP-FAIL (xterm) ###\n' > /dev/console ) 2>/dev/null
        fi
      elif rt_has weston-info; then
        out=$(pk-run --gui weston-info 2>&1 | tr '\n' ' ' | cut -c1-90)
        case "$out" in
          *"wl_compositor"*|*"wl_seat"*|*"Output"*|*"compositor"*)
            row ok guiapp "weston-info: $out"
            ( printf '### PK: GUI-APP-OK (weston-info) ###\n' > /dev/console ) 2>/dev/null ;;
          *) row fail guiapp "weston-info kuch nahi bola: ${out:-<khaali>} (log: /run/pk/x.log)"
             ( printf '### PK: GUI-APP-FAIL (weston-info) ###\n' > /dev/console ) 2>/dev/null ;;
        esac
      elif rt_has weston-terminal; then
        DISPLAY="$xd" pk-run --gui weston-terminal >/tmp/wl-cli.log 2>&1 &
        wlp=$!
        sleep 4
        if kill -0 "$wlp" 2>/dev/null; then
          row ok guiapp "weston-terminal zinda hai (compositor ne client accept kiya) ✓"
          ( printf '### PK: GUI-APP-OK (weston-terminal) ###\n' > /dev/console ) 2>/dev/null
          kill "$wlp" 2>/dev/null
        else
          row fail guiapp "weston-terminal turant band: $(tr '\n' '|' < /tmp/wl-cli.log 2>/dev/null | cut -c1-90)"
          ( printf '### PK: GUI-APP-FAIL (weston-terminal) ###\n' > /dev/console ) 2>/dev/null
        fi
      elif rt_has xterm; then
        row warn guiapp "DISPLAY nahi set (Wayland-only, XWayland nahi) - xterm skip"
      else
        row info guiapp "runtime me koi terminal client nahi (pk-get install -y xterm weston)"
      fi
      [ "$VERB" = 1 ] && { echo '  -- pk-x log --'; tail -6 /run/pk/x.log 2>/dev/null | sed 's/^/  /'; }
    else
      row fail display "pk-x start fail (rc=$rc) -- runtime me weston/Xvfb hai?  pk-get install -y weston xvfb x11-utils"
      tail -4 /run/pk/gui-start.log 2>/dev/null | sed 's/^/       /'
    fi
  else
    row warn display "pk-x nahi mila (image purani?)"
  fi
fi

# ------------------------------------------------------------------ network
ip=$(ip -4 addr show 2>/dev/null | awk '/inet /{if($2!~/^127\./){print $2; exit}}')
gw=$(ip route 2>/dev/null | awk '/default/{print $3; exit}')
if [ -n "$ip" ]; then
  row ok net "IP=$ip gw=${gw:-none}"
  if [ -n "$gw" ]; then
    if ping -c1 -W2 "$gw" >/dev/null 2>&1; then row ok ping "gateway reachable"; else row warn ping "gateway ping nahi gaya"; fi
  fi
  dns=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)
  if [ -n "$dns" ]; then
    row info dns "resolver=$dns"
    if ping -c1 -W3 "$dns" >/dev/null 2>&1; then row ok dns "$dns reachable (real resolve ke liye: wget -qO- http://deb.debian.org/ )"; else row warn dns "$dns ping nahi gaya (user-net gw DNS block karta hai)"; fi
  else
    row warn dns "/etc/resolv.conf me nameserver nahi"
  fi
else
  row warn net "koi IP nahi - 'pk-net dhcp' chalao (boot option pk_net=dhcp)"
fi
if [ -d /sys/class/net ]; then
  for n in /sys/class/net/*; do
    st=$(cat "$n/operstate" 2>/dev/null)
    [ "$st" = up ] && row info iface "${n##*/}=up"
  done
fi
# wifi
wdev=''
for w in /sys/class/net/*; do
  [ -e "$w/wireless" ] || [ -e "$w/phy80211" ] || continue
  wdev="$wdev ${w##*/}"
done
fw=''
for f in /lib/firmware /vendor_fw; do
  [ -d "$f" ] && fw="$fw $f:$(ls "$f" 2>/dev/null | wc -l)"
done
if command -v pk-wifi >/dev/null 2>&1; then
  ws=$(pk-wifi status 2>/dev/null | tr '\n' ' ' | tr -s ' ' | cut -c1-150)
  row info wifi "$ws"
elif [ -n "$wdev" ]; then row ok wifi "wireless iface:$wdev (pk-wifi nahi hai - image purani?)"; else row info wifi "wireless iface nahi dikha; firmware:${fw:- none} (ISO build me PK_FIRMWARE=1 se drivers aaate hain)"; fi
if [ -x /sbin/pk-ssh ]; then
  if pgrep dropbear >/dev/null 2>&1; then row ok ssh "dropbear :22 chal raha hai"; else row info ssh "dropbear band (pk-ssh start)"; fi
fi

# ------------------------------------------------------------------ runtime + apps
if mounted "$RT" && [ -d "$RT/usr" ]; then
  rel=$(cat "$RT/etc/pk-runtime-release" 2>/dev/null | head -1)
  row ok runtime "$RT attached (${rel:- no release file})"
  [ -x "$RT/usr/bin/apt-get" ] && row ok apt "runtime me apt-get hai -> pk-get install -y <pkg>" || row warn apt "runtime me apt-get nahi (tiny/QA runtime?)"
  [ -x "$RT/usr/bin/dpkg" ] && row info dpkg "dpkg hai (.deb install direct hoga)"
  if [ -x "$RT/usr/bin/wine" ] || [ -e "$RT/usr/bin/wine" ] || [ -L "$RT/usr/bin/wine" ]; then
    wv=$(pk-chroot /usr/bin/wine --version 2>/dev/null | head -1)
    row ok wine "wine: ${wv:-present}"
  else
    row info wine "wine nahi -> Windows apps ke liye: pk-get install -y wine"
  fi
  n=$(ls "$RT/var/lib/dpkg/info" 2>/dev/null | grep -c '\.list$')
  row info pkgcount "installed pkgs in runtime: ${n:-0}"
  m=$(ls -1 "$RT/apps/bin" 2>/dev/null | wc -l)
  row info appcount "pk apps: ${m:-0}"
else
  row info runtime "app runtime nahi laga (pk-runtime status) - base OS me bhi static/busybox apps chalti hain"
fi
if [ "$DOAPPS" = 1 ] && [ -x /sbin/pk-run ]; then
  out=$(pk-run --selftest 2>&1 | tr '\n' '|' | cut -c1-140)
  arc=$?
  if [ "$arc" = 0 ]; then
    row ok appbattery "pk-run --selftest pass: ${out:-(markers console/kmsg par)}"
  else
    row fail appbattery "pk-run --selftest rc=$arc: ${out:-(<khaali>)}"
  fi
fi

# ------------------------------------------------------------------ iOS / Android
if [ -x /sbin/pk-ios ]; then
  out=$(pk-ios doctor 2>&1 | tr '\n' ';' | cut -c1-150)
  row info ios "$out"
fi
if [ -x /sbin/pk-android ]; then
  out=$(pk-android doctor 2>&1 | tr '\n' ';' | cut -c1-150)
  row info android "$out"
fi

# ------------------------------------------------------------------ input + clock + secure boot
row info kbd "$(ls /sys/class/input 2>/dev/null | grep -c 'event') input event devices; keymap: $(cat /run/pk/keymap 2>/dev/null || echo us)"
rtc=$(hwclock -r 2>/dev/null | head -1)
if [ -n "$rtc" ]; then row ok clock "RTC: $rtc"; else row warn clock "hwclock padha nahi ja paya (battery/CMOS check)"; fi
sb=$(od -An -tx1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ')
if [ -n "$sb" ]; then
  case "$sb" in
    01) row warn secureboot "SecureBoot ON hai - unsigned GRUB boot nahi karega; BIOS me OFF karo (ya MOK enroll)" ;;
    00) row ok secureboot "SecureBoot OFF ✓ (hamara signed-naahi GRUB chalega)" ;;
    *)  row info secureboot "SecureBoot var value=$sb" ;;
  esac
else
  if [ -d /sys/firmware/efi ]; then row info secureboot "efi vars me SecureBoot nahi mila (CSM? ya var padhne se block)"; else row info secureboot "BIOS/Legacy boot (SecureBoot lagu nahi)"; fi
fi
if dmesg 2>/dev/null | grep -qiE "error|fail"; then
  n=$(dmesg 2>/dev/null | grep -ciE "error|fail")
  row warn dmesg "$n error/fail lines (verbose me dekho: dmesg | grep -iE 'error|fail')"
  [ "$VERB" = 1 ] && dmesg 2>/dev/null | grep -iE "error|fail" | tail -8 | sed 's/^/       /'
else
  row ok dmesg "koi error/fail line nahi"
fi

# ------------------------------------------------------------------ summary
sum=$(printf 'CHECK-SUMMARY ok=%s fail=%s warn=%s info=%s' "$pass_n" "$fail_n" "$warn_n" "$info_n")
echo
printf '%s\n' "----------------------------------------------------------------"
printf '%s\n' "  $sum"
printf '%s\n' "----------------------------------------------------------------"
if [ "$fail_n" = 0 ]; then
  ( printf '### PK: %s ###\n' "$sum" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-OK (%s checks, 0 fail) ###\n' "$pass_n" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-OK ###\n' > /dev/kmsg ) 2>/dev/null
else
  ( printf '### PK: %s ###\n' "$sum" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-FAIL(%s) ###\n' "$fail_n" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-FAIL(%s) ###\n' "$fail_n" > /dev/kmsg ) 2>/dev/null
fi
if [ "$SAVE" = 1 ]; then
  {
    printf 'pk-check report %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '?')"
    cat "$ROWS" 2>/dev/null
    printf '\n%s\n' "$sum"
  } > "$REP" 2>/dev/null
  cp -f "$REP" /tmp/pk-check.txt 2>/dev/null
  printf '%s\n' "report: $REP (+ /tmp/pk-check.txt)"
fi
[ "$fail_n" = 0 ] && exit 0
exit 1
