#!/bin/sh
# pk's OS :: start a desktop session (weston/KMS -> Xorg -> Xvfb fallback)
#   pk-desktop                start + one terminal + welcome
#   pk-desktop app <x>        open a GUI app (pk-run --gui)
#   pk-desktop status         what is running, which display
#   pk-desktop stop           end the session
#   pk-desktop vnc <port>     Xvfb + vnc (to see the screen of a headless machine)
#   pk-desktop shot [file]    PNG of the desktop straight from weston (QA / evidence)
#   pk-desktop outputs        connected displays + current modes (from DRM)
#   pk-desktop scale 2 [OUT]  high-DPI scaling (weston.ini); mode/transform/arrange too
#   pk-desktop restart        reload the ini (restart the session)
#
# Best experience with weston + xterm in the runtime (make runtime --variant=desktop/full).
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
have() { command -v "$1" >/dev/null 2>&1; }
say()  { printf 'pk-desktop: %s\n' "$*"; }
warn() { printf 'pk-desktop: %s\n' "$*" >&2; }
mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; ( printf '%s\n' "$*" > /dev/kmsg ) 2>/dev/null; }
runtime_ok() { grep -q " $RT " /proc/mounts 2>/dev/null && [ -d "$RT/usr" ]; }
rtbin() { runtime_ok && { [ -x "$RT/usr/bin/$1" ] || [ -e "$RT/usr/bin/$1" ] || [ -L "$RT/usr/bin/$1" ]; }; }

INI=""   # set karta hoon pehli baar jab zaroorat pade
ini_path() {
  [ -n "$INI" ] && return 0
  if [ -d "$RT/etc" ]; then INI=$RT/etc/weston.ini; else INI=/etc/weston.ini; fi
}
ini_set() { # <section> <key> <value>
  ini_path
  sec=$1; k=$2; v=$3
  mkdir -p "$(dirname "$INI")" 2>/dev/null
  touch "$INI" 2>/dev/null || { warn "$INI likhne layak nahi"; return 1; }
  awk -v sec="$sec" -v k="$k" -v v="$v" '
    BEGIN { hdr="[" sec "]"; insec=0; seen=0; exists=0 }
    /^\[/ {
      if (insec && !seen) { print k "=" v; seen=1 }
      insec = ($0 == hdr)
      if ($0 == hdr) exists=1
      print; next
    }
    {
      if (insec && !seen && $0 ~ "^" k "=") { print k "=" v; seen=1; next }
      print
    }
    END {
      if (insec && !seen) print k "=" v
      else if (!exists) { printf ""; printf "\n%s\n%s=%s\n", hdr, k, v }
    }' "$INI" > "$INI.new" 2>/dev/null && mv -f "$INI.new" "$INI"
  say "$INI me [$sec] $k=$v"
}
drm_outputs() {
  n=0
  for c in /sys/class/drm/card*-*/; do
    [ -d "$c" ] || continue
    st=$(cat "$c/status" 2>/dev/null)
    [ "$st" = connected ] || continue
    nm=$(basename "$c"); nm=${nm#card*-}
    mode=$(head -1 "$c/modes" 2>/dev/null)
    allmodes=$(tr '\n' ' ' < "$c/modes" 2>/dev/null | cut -c1-70)
    dpms=$(cat "$c/dpms" 2>/dev/null)
    printf '  %-14s %s  current=%s  dpms=%s\n' "$nm" "$st" "${mode:-?}" "${dpms:-?}"
    [ -n "$allmodes" ] && printf '                 modes: %s\n' "$allmodes"
    n=$((n + 1))
  done
  [ "$n" = 0 ] && printf '  (koi connected DRM output nahi - VM/headless?)\n'
  return 0
}
outputs() {
  printf 'connected displays (/sys/class/drm):\n'
  drm_outputs
  if [ -r /run/pk/x-env ]; then
    . /run/pk/x-env
    printf 'session: DISPLAY=%s WAYLAND=%s\n' "${DISPLAY:-none}" "${WAYLAND_DISPLAY:-none}"
  else
    printf 'session: koi nahi (pk-desktop chalao)\n'
  fi
  ini_path
  [ -f "$INI" ] && { printf '\nweston.ini (%s):\n' "$INI"; sed -n '1,40p' "$INI" | sed 's/^/  /'; }
  mark "DESKTOP-OUTPUTS-OK"
}
status() {
  if [ -r /run/pk/x-env ]; then
    . /run/pk/x-env
    echo "display : DISPLAY=${DISPLAY:-none} WAYLAND=${WAYLAND_DISPLAY:-none}"
  else
    echo "display : koi session nahi (/run/pk/x-env nahi hai)"
  fi
  echo "compositor: $(cat /run/pk/x.kind 2>/dev/null || echo '?')"
  echo "log       : /run/pk/x.log (last 5)"
  tail -5 /run/pk/x.log 2>/dev/null | sed 's/^/  /'
}

start() {
  if ! runtime_ok; then
    warn "app runtime nahi laga -> GUI ke liye runtime chahiye (weston/xterm uske andar hote hain)"
    warn "  sudo make runtime  (build/pk-runtime.sqfs)  ->  make iso WITH_RUNTIME=1"
    warn "  ya live me:  pk-runtime start"
    mark "DESKTOP-NO-RUNTIME"
    return 71
  fi
  if ! rtbin weston && ! rtbin Xorg && ! rtbin Xvfb; then
    say "runtime me koi compositor nahi -> install kar rahe hain (net chahiye)"
    pk-get install -y weston xterm >/dev/null 2>&1 || pk-get install -y xvfb xterm >/dev/null 2>&1 || {
      warn "install fail (net? 'pk-net dhcp') - manual: pk-get install -y weston xterm xvfb x11-utils"
      mark "DESKTOP-INSTALL-FAIL"; return 70; }
  fi
  # weston ka default background black hota hai (theme image ke bina) -> "desktop aayi
  # ya nahi" ka farak screen par dikhna chahiye, isliye solid-color set karte hain.
  if ini_set output background-type solid-color >/dev/null 2>&1; then
    ini_set output background-color 0xFF1a5fb4 >/dev/null 2>&1 || true
  fi
  # xkb layout (pk_keymap= se diya ho to weston ko bhi batao)
  kl=$(sed -n 's/.*pk_keymap=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null | head -1)
  [ -n "${kl:-}" ] && { ini_set xkb layout "$kl" >/dev/null 2>&1 || true; }
  pk-x start >/run/pk/desktop.log 2>&1 || pk-x start weston >>/run/pk/desktop.log 2>&1
  # weston ka aakhri error user ko marker me dikhe (warna "DESKTOP-OK (:0)" ke peeche
  # pura reason /run/pk/x-weston.log me dab jaata tha - debug namumkin jaisa).
  wx=$(tail -c 220 /run/pk/x-weston.log 2>/dev/null | tr '\n' '|' | tr -s ' ')
  [ -n "${wx:-}" ] && printf '### PK: DESKTOP-WESTON-LOG %s ###\n' "$wx" > /dev/console 2>/dev/null
  if [ -r /run/pk/x-env ]; then . /run/pk/x-env; fi
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    warn "session nahi utha; detail: cat /run/pk/x.log"
    mark "DESKTOP-FAIL"
    return 1
  fi
  # welcome + terminal
  cat > /root/pk-desktop-welcome.txt <<'W'
pk's OS desktop
  apps     :  pk-run --gui xterm        (ya terminal me jo bhi)
             pk-run --gui htop
             pk-get install -y firefox-esr && pk-run --gui firefox-esr
  install  :  pk-install --target=auto   (disk pe permanent)
  check    :  pk-check --all
  iOS/Android: pk-ios why ; pk-android doctor
W
  if [ -e /run/pk/x-term ]; then
    say "terminal already chal chuka hai (pk-x ne bheja) - duplicate nahi khologe"
  elif [ -n "${DISPLAY:-}" ] && rtbin xterm; then
    pk-run --gui xterm -e sh -c 'cat /root/pk-desktop-welcome.txt; echo; exec /bin/sh' >/dev/null 2>&1 &
    say "terminal khola (xterm)"
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && rtbin weston-terminal; then
    pk-run --gui weston-terminal >/dev/null 2>&1 &
    say "terminal khola (weston-terminal)"
  else
    say "session ready hai; client nahi khola (xterm/weston-terminal runtime me nahi)"
    say "  app:  pk-desktop app <naam>   (jaise: pk-desktop app htop)"
  fi
  # foreground priority (cgroup apps slice -> cpu.weight 200)
  if command -v pk-tune >/dev/null 2>&1; then
    for sess in weston Xorg Xvfb; do pk-tune fg "$sess" >/dev/null 2>&1 && break; done
  fi
  say "session chal raha hai: DISPLAY=${DISPLAY:-} WAYLAND=${WAYLAND_DISPLAY:-}"
  say "terminal khola (agar xterm hai). App:  pk-desktop app <naam>"
  mark "DESKTOP-OK (${DISPLAY:-${WAYLAND_DISPLAY:-?}})"
  return 0
}

vnc() {
  port=${1:-5900}
  if ! have pk-x; then
    warn "pk-x nahi mila"; return 70
  fi
  if ! rtbin Xvfb; then warn "Xvfb nahi -> pk-get install -y xvfb x11-xserver-utils"; return 70; fi
  pk-x start xvfb >/dev/null 2>&1
  if rtbin x11vnc; then
    say "x11vnc :$port start (host se: ssh -L $port:localhost:$port root@<ip> phir vnc viewer)"
    pk-chroot /usr/bin/x11vnc -forever -shared -localhost -rfbport "$port" >/run/pk/vnc.log 2>&1 &
    mark "DESKTOP-VNC-OK ($port)"
  else
    warn "x11vnc nahi -> pk-get install -y x11vnc"
    return 70
  fi
}

# ------------------------------------------------------------------ shot
# weston se *apni* screen capture karwata hai (weston-screenshooter; iske liye
# weston --debug chahiye, jo pk-x lagata hai). Ye QA ka pixel-evidence hai:
# "desktop aaya ya nahi" ka jawab screenshot se milta hai, markers se nahi.
do_shot() {
  out=${1:-/run/pk/desktop-shot.png}
  runtime_ok || { warn "runtime attach nahi -> pk-desktop start pehle"; return 66; }
  if ! grep -qs 'WAYLAND_DISPLAY' /run/pk/x-env 2>/dev/null; then
    warn "Wayland session nahi chal raha (Xvfb/X11 session me ye kaam nahi karta)"
    warn "  X11 ke liye: pk-chroot /bin/sh -c 'DISPLAY=:0 xwd -root -out /root/s.xwd' (x11-utils)"
    return 66
  fi
  tmp=/root/.pk-shot.$$.png
  to=""; have timeout && to="timeout 25"   # screenshooter compositor ka wait karta hai ->
  $to pk-chroot /bin/sh -c "export XDG_RUNTIME_DIR=/run/pk-x WAYLAND_DISPLAY=wayland-1; cd /root; weston-screenshooter $tmp" >/run/pk/shot.log 2>&1
  rc=$?
  [ "$rc" = 124 ] && warn "screenshot 25s me nahi aaya (compositor busy/debug off?) - log: /run/pk/shot.log"
  if [ -s "$RT/root/.pk-shot.$$.png" ] || [ -s "/root/.pk-shot.$$.png" ]; then
    src="$RT/root/.pk-shot.$$.png"; [ -s "$src" ] || src=$tmp
    mkdir -p "$(dirname "$out")" 2>/dev/null
    cp -f "$src" "$out" 2>/dev/null && { rm -f "$src" "$tmp" 2>/dev/null
      printf 'pk-desktop: shot %s (%s B)\n' "$out" "$(wc -c < "$out" 2>/dev/null)"
      printf '### PK: GUI-SHOT-OK (%s bytes -> %s) ###\n' "$(wc -c < "$out" 2>/dev/null)" "$out" > /dev/console 2>/dev/null
      return 0; }
  fi
  warn "screenshot nahi bana (rc=$rc) - weston --debug laga hona chahiye; log:"
  tail -3 /run/pk/shot.log 2>/dev/null | sed 's/^/  /'
  printf '### PK: GUI-SHOT-FAIL (rc=%s) ###\n' "$rc" > /dev/console 2>/dev/null
  return 1
}

case "${1:-start}" in
  start|"") shift 2>/dev/null || true; start ;;
  app)      shift; [ $# -gt 0 ] || { echo "usage: pk-desktop app <x> [args...]"; exit 1; }
            [ -r /run/pk/x-env ] && . /run/pk/x-env && export DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR
            pk-run --gui "$@" &
            ap=$!
            # app ko foreground slice me daalo (interactive priority)
            command -v pk-tune >/dev/null 2>&1 && pk-tune fg "$ap" >/dev/null 2>&1 || true
            wait "$ap" ;;
  shot)
    shift; do_shot "${1:-}" ;;
  status)   status ;;
  outputs|displays|monitors) outputs ;;
  scale)
    shift; sc=${1:-1}; out=${2:-}
    [ -n "$out" ] && ini_set "output:$out" scale "$sc" || ini_set "output" scale "$sc"
    say "scale=$sc set kiya (weston HiDPI); session reload: pk-desktop restart"
    mark "DESKTOP-SCALE-OK ($sc${out:+ on $out})" ;;
  mode)
    shift; out=${1:-}; m=${2:-}
    [ -n "$out" ] && [ -n "$m" ] || { echo "usage: pk-desktop mode <OUTPUT> <WxH[@Hz]>"; exit 1; }
    ini_set "output:$out" mode "$m"; mark "DESKTOP-MODE-OK ($out $m)" ;;
  transform)
    shift; out=${1:-}; t=${2:-normal}
    ini_set "output:$out" transform "$t"; mark "DESKTOP-TRANSFORM-OK ($out $t)" ;;
  arrange)
    shift; x=0
    for o in "$@"; do
      ini_set "output:$o" x "$x"; ini_set "output:$o" y "0"
      x=$((x + 1920))
    done
    say "layout likha (left-to-right: $*); restart karo"; mark "DESKTOP-ARRANGE-OK" ;;
  ini)    ini_path; [ -f "$INI" ] && cat "$INI" || echo "(ini nahi bani abhi)"; ;;
  restart)
    pk-x stop >/dev/null 2>&1
    start ;;
  stop)     pk-x stop ;;
  vnc)      shift; vnc "${1:-5900}" ;;
  --help|-h) sed -n '2,13p' "$0" ;;
  *) warn "unknown: $1"; exit 1 ;;
esac
