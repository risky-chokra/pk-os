#!/bin/sh
# pk's OS :: fixes the group/mode of /dev nodes that mdev did not touch - especially nodes
# devtmpfs had already created, and nodes that only appear once the GPU driver has loaded.
#   pk-devperms            # one fix-up pass
#   pk-devperms --watch    # five passes, 2 s apart (for drivers that bind late)
# Groups are resolved from /etc/group; a missing group means the entry is skipped quietly
# (a base ISO without sound hardware has no /dev/snd at all).
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
GRP() { awk -F: -v G="$1" '$1==G{print $3; exit}' /etc/group 2>/dev/null; }
say() { printf 'pk-devperms: %s\n' "$*"; }
fix() { # <glob> <group> <mode>
  pat=$1; g=$2; m=$3; gid=$(GRP "$g")
  [ -n "${gid:-}" ] || { say "group '$g' /etc/group me nahi -> $pat skip"; return 0; }
  n=0
  for f in $pat; do
    [ -e "$f" ] || continue
    chgrp "$gid" "$f" 2>/dev/null && n=$((n + 1))
    chmod "$m" "$f" 2>/dev/null
  done
  [ "$n" != 0 ] && say "$pat -> :$g ($m), $n nodes"
  return 0
}
rounds=1
[ "${1:-}" = "--watch" ] && rounds=5
i=0
while [ $i -lt $rounds ]; do
  i=$((i + 1))
  fix "/dev/dri/card*"           video   660
  fix "/dev/dri/renderD*"        render  666
  fix "/dev/fb*"                 video   660
  fix "/dev/input/event*"        input   660
  fix "/dev/input/mouse*"        input   660
  fix "/dev/input/touchscreen*"  input   660
  fix "/dev/snd/*"               audio   660
  fix "/dev/snd/seq"             audio   666
  fix "/dev/snd/timer"           audio   666
  fix "/dev/video*"              video   660
  fix "/dev/media*"              video   660
  fix "/dev/tty[0-9]*"           tty     620
  fix "/dev/ttyUSB*"             dialout 660
  fix "/dev/ttyACM*"             dialout 660
  fix "/dev/ttyS*"               dialout 660
  fix "/dev/usb/lp*"             lp      660
  fix "/dev/hidraw*"             input   660
  [ $i -lt $rounds ] && sleep 2
done
exit 0
