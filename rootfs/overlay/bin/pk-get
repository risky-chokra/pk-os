#!/bin/sh
# pk's OS :: apt-get inside the app runtime (for installing Linux apps)
#   pk-get update
#   pk-get install -y htop wine default-jre-headless
#   pk-get install -y /path/to/app.deb
#   pk-get -y htop                 (short form of: install -y)
# Needs network first: 'pk-net dhcp' (or the pk_net=dhcp boot option).
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
rt=${PK_RUNTIME_ROOT:-/opt/pk}
if ! grep -q " $rt " /proc/mounts 2>/dev/null; then
  echo "pk-get: the runtime is not attached. Run 'pk-runtime start', or use an ISO built with WITH_RUNTIME=1." >&2
  echo "        (to build the runtime on the host: scripts/make-runtime)" >&2
  exit 64
fi
ip=$(ip -4 addr show 2>/dev/null | awk '/inet /{if($2!~/^127\./){print $2; exit}}')
[ -n "${ip:-}" ] || echo "pk-get: warning - no IP address (for DHCP: pk-net dhcp)" >&2

if [ $# = 0 ]; then
  set -- update
else
  case "$1" in
    -y|--yes) shift; set -- install -y "$@" ;;
  esac
fi

# to keep the runtime image small, apt package lists are removed;
# without 'update', install gives "Unable to locate package" -> update it ourselves.
need_update=0
case "$1" in
  install|remove|purge|upgrade|autoremove|search|show)
    if ! ls "$rt/var/lib/apt/lists" 2>/dev/null | grep -q '_Packages\|_Sources\|Packages'; then
      need_update=1
    fi ;;
esac
if [ "$need_update" = 1 ]; then
  echo "pk-get: apt's package lists are empty -> run 'apt-get update' once (needs network)" >&2
  pk-chroot /usr/bin/apt-get update -qq -o 'Acquire::Retries=2' >&2 || \
    echo "pk-get: update failed (check the network/Debian mirror) - trying the install anyway" >&2
fi

case "$1" in
  update|upgrade|install|remove|purge|autoremove|search|show) exec pk-chroot /usr/bin/apt-get "$@" ;;
esac
exec pk-chroot /usr/bin/apt-get "$@"
