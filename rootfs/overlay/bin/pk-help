#!/bin/sh
# pk's OS :: help (live + installed system me 'help' ya pk-help se milti hai)
DOC=/usr/share/doc/pkos/README.md
cat <<'TXT'
pk's OS 1.0 - commands
----------------------
  pk-info        system report (boot mode, disk, net, modules)
  pk-check       hardware + OS self-test (pendrive test!)  --save --gui --all
  pk-help        ye list

apps (App Runtime - 'sudo make runtime' + WITH_RUNTIME=1 se ISO me, ya kisi
partition par pk-runtime.sqfs; phir boot par /opt/pk par apne aap mount)
  pk-run <x>     kuch bhi chalao: ELF, script, .deb, .exe/.msi (Wine), AppImage, .jar
                 pk-run --info <file>     type batao (pehchanno ke liye)
                 pk-run --install <file>  .deb/.rpm/binary install
                 pk-run --list            installed apps + runtime ka haal
                 pk-run --gui <app>       display ke saath       pk-run --selftest  (QA)
  pk-shell       runtime ke andar shell (Debian userland)   [pk-shell -c "cmd"]
  pk-get         runtime ke andar apt-get:  pk-get install -y htop wine
  pk-runtime     start | stop | status | find | --setup <pk-runtime.sqfs> [dev]
  pk-chroot      runtime me koi command:  pk-chroot /usr/bin/htop
  pk-x           GUI: pk-x start weston | pk-x status | pk-x stop
  pk-desktop     desktop session (weston -> Xvfb fallback) | pk-desktop app <x>
  pk-keymap      keyboard layout (console + GUI):  pk-keymap in | uk | de
  pk-user        users add/remove/list/autologin:  pk-user add bob --admin
  pk-seatd       session manager (weston ko VT/dri/input):  pk-seatd status
  pk-wifi        Wi-Fi (experimental): status | scan | connect <ssid> <pw> | stop
                 boot option: pk_wifi=<ssid>:<password>   (wpa_supplicant runtime me: pk-get install -y wpasupplicant iw)
  pk-ios         iOS apps ka sach: why | info file.ipa | web <url> | mac-guest | darling
  pk-android     Android: doctor | enable | install file.apk | kernel-frag
  pk-vm          guest VM (Windows / Android-x86 / macOS raasta):
                 pk-vm new win --size=40G | pk-vm run win --cdrom=x.iso | pk-vm list

system
  pk-net dhcp          DHCP se IP        (boot option: pk_net=dhcp)
  pk-ssh start         dropbear :22      (boot option: pk_ssh=on)
  pk-install           internal disk pe install  (--info / --target=auto / --help)
  pk-persist setup     live USB pe hi persistence partition
  dmesg | grep PK      boot markers (BOOT-OK, NET-OK, RUNTIME-OK, APPS-OK...)
  vi                   editor          reboot / poweroff

boot options (GRUB menu me 'e' dabao): pk_net=dhcp, pk_ssh=on, persistent, toram,
  pk_install=auto (ya /dev/sda, ask), pk_rootpw=..., pk_runtime=off|auto|/dev/sda3,
  pk_apps_get=<pkg>[:args], pk_selftest, pk_debug, break=mount, single
TXT
if [ -f "$DOC" ]; then
  echo
  echo "puri detail:  less $DOC   (apps section: 'Apps chalana')"
fi
