#!/bin/sh
# pk's OS :: seatd - the small session manager that gives the GUI (weston) its VT plus
# /dev/dri and /dev/input. The live system has no systemd-logind, and weston 10's DRM
# backend cannot take a VT without logind/seatd: the compositor ran, but the screen kept
# showing the text console. seatd does that job in 30 KB.
#
#   pk-seatd start | stop | status | restart      (the S55seatd boot hook runs 'start')
#   boot options: pk_seatd=on|off                 (default on, if the runtime has seatd)
#
# seatd comes from the app runtime (a Debian package), so the base ISO stays small; the
# socket is created in the runtime's /run, which is where weston looks for it.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
PIDF=/run/pk/seatd.pid
LOGF=/run/pk/seatd.log
SOCK=$RT/run/seatd.sock
say()  { printf 'pk-seatd: %s\n' "$*"; }
mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; printf '%s\n' "$*" > /dev/kmsg 2>/dev/null; }
mounted() { grep -q " $RT " /proc/mounts 2>/dev/null; }
have() { command -v "$1" >/dev/null 2>&1; }
rbin() { [ -x "$RT/usr/sbin/$1" ] || [ -x "$RT/usr/bin/$1" ]; }

start() {
  # the S55seatd hook runs right after runtime-attach, but the overlay mount may settle a little late
  # -> wait up to 15s, only then skip. (Else, depending on hook order,
  # "SEATD-SKIP (no runtime)" used to appear though the runtime attached 2s later.)
  i=0
  while ! mounted; do
    i=$((i + 1)); [ $i -gt 15 ] && break
    sleep 1
  done
  mounted || { say "no runtime attached (pk-runtime start) - skipping seatd"; mark "SEATD-SKIP (no runtime)"; return 64; }
  rbin seatd || { say "seatd is not in the runtime -> pk-get install -y seatd"; mark "SEATD-SKIP (seatd not in runtime)"; return 70; }
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
    say "already running (pid $(cat "$PIDF"))"$PIDF"))"; mark "SEATD-OK (already, pid $(cat "$PIDF"))"; return 0
  fi
  mkdir -p /run/pk "$RT/run" 2>/dev/null
  rm -f "$SOCK" 2>/dev/null
  # seatd resolves the '-g seat' group -> also needed in the runtime's /etc/group
  grep -qs '^seat:' "$RT/etc/group" 2>/dev/null || printf 'seat:x:990:\n' >> "$RT/etc/group" 2>/dev/null
  grep -qs '^seat:' /etc/group 2>/dev/null || addgroup seat >/dev/null 2>&1
  # daemon: inside pk-chroot, so the socket lands where weston looks
  # two tries: first with group 'seat' (multi-user access), else a plain root socket.
  # 'setsid' so the daemon survives even when the shell closes.
  # NOTE: seatd -u needs a *name* (it does getpwnam). On giving "-u 0" it
  #   used to exit with "Could not find user by name 0." (caught in the guest).
  for args in "-u root -g seat -l error" "-u root -l error"; do
    setsid pk-chroot /bin/sh -c "exec /usr/sbin/seatd $args 2>&1 || exec seatd $args 2>&1" >>"$LOGF" 2>&1 &
    echo $! > "$PIDF" 2>/dev/null
    i=0
    while [ $i -lt 10 ]; do
      [ -S "$SOCK" ] && break
      sleep 1; i=$((i + 1))
    done
    [ -S "$SOCK" ] && break
    say "try '$args' failed -> next attempt"
    kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null || true
  done
  if [ -S "$SOCK" ]; then
    chmod 660 "$SOCK" 2>/dev/null || true
    chgrp seat "$SOCK" 2>/dev/null || true
    # reachable from the live side too (weston itself is root; no risk from 666 since
    # the node is mounted only inside the runtime)
    say "starting: socket=$SOCK group=seat pid=$(cat "$PIDF" 2>/dev/null)"$PIDF" 2>/dev/null)"
    mark "SEATD-OK (socket=/run/seatd.sock in runtime, pid=$(cat "$PIDF" 2>/dev/null))"
    return 0
  fi
  say "the socket was never created; log: $LOGF"
  tail -4 "$LOGF" 2>/dev/null | sed 's/^/    /'
  sr=$(tail -c 150 "$LOGF" 2>/dev/null | tr '\n' '|' | tr -s ' ')
  mark "SEATD-FAIL (no socket was created: ${sr:-no-log})"
  return 1
}

stop() {
  if [ -f "$PIDF" ]; then kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null || true; rm -f "$PIDF"; fi
  pk-chroot /bin/sh -c 'pkill -x seatd 2>/dev/null' >/dev/null 2>&1 || true
  say "stopped"
}

status() {
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
    echo "pk-seatd: RUNNING (pid $(cat "$PIDF"))"
  else
    echo "pk-seatd: stopped"
  fi
  if [ -S "$SOCK" ]; then ls -l "$SOCK" | sed 's/^/  /'; else echo "  no socket at $SOCK"; fi
  grep -qs '^seat:' /etc/group && echo "  live group seat: yes" || echo "  live group seat: NO"
  echo " weston for env: LIBSEAT_BACKEND=seatd XDG_SEAT=seat0 XDG_VTNR=<active vt>"
  [ -s "$LOGF" ] && { echo "  log (last 5):"; tail -5 "$LOGF" | sed 's/^/    /'; }
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  *) echo "usage: pk-seatd start|stop|restart|status"; exit 1 ;;
esac
