#!/bin/sh
# pk's OS :: shell inside the app runtime (the Debian userland)
#   pk-shell            -> root shell in /opt/pk
#   pk-shell -c "cmd"   -> run just that command there
# The bind mounts are not unmounted when you exit (running apps may need them);
# use 'pk-shell --clean' to remove them.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
if [ "${1:-}" = --clean ]; then exec pk-chroot --umount; fi
[ -t 0 ] || { exec pk-chroot "$@"; }
echo "pk's OS runtime shell - type 'exit' to leave.  pkgs: apt-get, dpkg  |  apps: pk-run --list"
echo "release: $(cat /opt/pk/etc/pk-runtime-release 2>/dev/null || echo '(no release file in the runtime)')"
exec pk-chroot /bin/sh
