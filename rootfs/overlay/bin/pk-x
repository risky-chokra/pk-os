#!/bin/sh
# pk's OS :: display server for GUI apps - weston/Xorg/Xvfb from inside the runtime
#   pk-x start            # bring up a session with whatever is there (weston -> Xorg -> Xvfb)
#   pk-x start weston     # a specific backend
#   pk-x status | stop
# Then:  pk-run --gui <app>
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
ENVR=/run/pk/x-env
PIDF=/run/pk/x.pid
LOGF=/run/pk/x.log
have() { command -v "$1" >/dev/null 2>&1; }
mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }
say() { printf 'pk-x: %s\n' "$*"; }
rbin() { [ -x "$RT/usr/bin/$1" ] || [ -x "$RT/bin/$1" ]; }

start() {
  want=${1:-auto}
  mounted "$RT" || { say "no runtime attached -> pk-runtime start"; exit 64; }
  # idempotent: pk-boot aur pk-check --gui dono se do baar call ho sakta hai - dusre
  # instance par weston "unable to lock wayland-1.lock" de kar Xvfb par gir jaata tha.
  if [ -S "$RT/run/pk-x/wayland-1" ] && pidof weston >/dev/null 2>&1; then
    say "a Wayland session is already running (weston pid $(pidof weston)) - not starting a second one"
    [ -r "$ENVR" ] || printf 'WAYLAND_DISPLAY=wayland-1\nXDG_RUNTIME_DIR=/run/pk-x\nPK_XDG_RUNTIME_HOST=%s\nDISPLAY=\n' "$RT/run/pk-x" > "$ENVR" 2>/dev/null
    return 0
  fi
  # KMS device ke bina weston sirf 'headless' backend par chadhta hai -> session ready
  # dikhega par SCREEN PAR KUCH NAHI (log isi ko "no desktop appeared" kehte hain).
  # Isliye auto mode me /dev/dri/card* dekho: na ho to Xvfb (VNC-able) prefer karo.
  hasdrm=0
  for c in /dev/dri/card*; do [ -e "$c" ] && { hasdrm=1; break; }; done
  if [ "$want" = auto ] && [ "$hasdrm" = 0 ] && rbin Xvfb; then
    say "no KMS device (/dev/dri/card*) -> chose Xvfb instead of weston (nothing on the panel; use VNC)"
    want=Xvfb
  fi
  [ "$want" = auto ] && for c in weston Xorg Xvfb; do rbin "$c" && { want=$c; break; }; done
  case "$want" in
    weston)
      for d in /dev/dri /dev/input /dev/snd; do
        [ -e "$d" ] && { mkdir -p "$RT$d"; mounted "$RT$d" || mount --bind "$d" "$RT$d" 2>/dev/null || true; }
      done
      # seatd (S55seatd / pk-boot) ka socket runtime ke andar hota hai; weston wahi
      # dhoondhta hai - mil gaya to VT + DRM + input ek saath, bina logind ke.
      [ -S "$RT/run/seatd.sock" ] && SEATD=1 || SEATD=0
      # weston ko WAHI VT par bithao jo screen par dikhta hai; warna wo free VT (tty7)
      # le leta hai aur user ko text console hi dikhta rehta hai.
      VT=$(sed -n 's/^tty//p' /sys/devices/virtual/tty/tty0/active 2>/dev/null | tr -d ' \n')
      case "${VT:-}" in ''|*[!0-9]*) VT=1 ;; esac
      [ -c "/dev/tty$VT" ] || VT=1
      # NOTE 1: `exec weston ... || exec weston ...` mat likho - exec shell kha jaata hai,
      #   to fallback attempts KABHI nahi chalte the (isi wajah se desktop kabhi nahi aaya).
      # NOTE 2: weston ke DRM backend ko VT chahiye ('<stdin> not a vt' -> --tty) aur
      #   session ke liye logind/seatd. NOTE 3: 2>/dev/wali cheez reason chhupa leti thi -
      #   ab har attempt ka output /run/pk/x-weston.log me rehta hai.
      { printf 'pk-x: weston start (RT=%s hasdrm=%s seatd=%s vt=tty%s dri=%s)\n' "$RT" "${hasdrm:-0}" "$SEATD" "$VT" "$(ls /dev/dri/card* 2>/dev/null | tr '\n' ' ')"; } > /run/pk/x-weston.log 2>&1
      mkdir -p "$RT/run/pk-x" 2>/dev/null; rm -f "$RT/run/pk-x/wayland-1" "$RT/run/pk-x/wayland-1.lock" 2>/dev/null || true
      say "weston (Wayland) start - VT=tty$VT seatd=$SEATD (log: /run/pk/x-weston.log)"
      pk-chroot /bin/sh -c "mkdir -p /run/pk-x; chmod 700 /run/pk-x; export XDG_RUNTIME_DIR=/run/pk-x XKB_DEFAULT_LAYOUT=us XDG_SEAT=seat0 XDG_VTNR=$VT; test -d /usr/lib/dri || { export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe; }; if [ -S /run/seatd.sock ]; then LIBSEAT_BACKEND=seatd weston --debug --backend=drm-backend.so --socket=wayland-1; fi; test -S /run/pk-x/wayland-1 || LIBSEAT_BACKEND=builtin weston --debug --backend=drm-backend.so --tty=/dev/tty$VT </dev/tty$VT; test -S /run/pk-x/wayland-1 || weston --debug --backend=drm-backend.so --socket=wayland-1; test -S /run/pk-x/wayland-1 || weston --debug --backend=headless-backend.so --socket=wayland-1" >>/run/pk/x-weston.log 2>&1 &
      echo $! > "$PIDF"
      # socket ka wait: iske bina 'x-env' likh dena = jhootha success
      j=0
      while [ $j -lt 25 ]; do
        [ -S "$RT/run/pk-x/wayland-1" ] && break
        sleep 1; j=$((j + 1))
      done
      if [ -S "$RT/run/pk-x/wayland-1" ]; then
        # clients chroot ke andar chalte hain -> in-chroot path hi do
        printf 'WAYLAND_DISPLAY=wayland-1\nXDG_RUNTIME_DIR=/run/pk-x\nPK_XDG_RUNTIME_HOST=%s\nDISPLAY=\n' "$RT/run/pk-x" > /run/pk/x-env
        NOWVT=$(sed -n 's/^tty//p' /sys/devices/virtual/tty/tty0/active 2>/dev/null | tr -d ' \n')
        printf 'weston vt=tty%s seatd=%s wait=%ss active=tty%s\n' "$VT" "$SEATD" "$j" "${NOWVT:-?}" > /run/pk/x-how
        say "weston ready (socket: $RT/run/pk-x/wayland-1, ${j}s, VT=tty$VT seatd=$SEATD)"
        printf '### PK: DESKTOP-VT (want=tty%s active=tty%s seatd=%s) ###\n' "$VT" "${NOWVT:-?}" "$SEATD" > /dev/console 2>/dev/null
        if [ "${NOWVT:-}" != "$VT" ]; then
          warn "weston is running but the screen still shows tty${NOWVT:-?} (no VT switch) - 'pk-desktop vnc 5900'"
          printf '### PK: DESKTOP-VTMISMATCH (want=tty%s active=tty%s) ###\n' "$VT" "${NOWVT:-?}" > /dev/console 2>/dev/null
        fi
        # session ke baad ek client chahiye, warna weston ki screen plain black dikhti
        # hai ("desktop aaya ya nahi" ka fark hi nahi pata chalta). weston ka apna
        # terminal (X nahi) - isliye Xwayland ke bhi bhi chalta hai.
        # A weston that opens its socket and then dies (GL init failure - typical for a
        # VM with 3D acceleration switched off, or a KMS driver weston cannot render on)
        # used to leave DESKTOP-OK on the console while the user stared at text. So check
        # liveness, then try the software renderer, then fall back to Xvfb.
        sleep 3
        if ! kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
          warn "weston opened the socket but died right after - retrying with the software renderer (no GL)"
          tail -4 /run/pk/x-weston.log 2>/dev/null | sed 's/^/    /'
          pk-chroot /bin/sh -c "mkdir -p /run/pk-x; chmod 700 /run/pk-x; export XDG_RUNTIME_DIR=/run/pk-x XKB_DEFAULT_LAYOUT=us XDG_VTNR=$VT LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe; test -S /run/seatd.sock && LIBSEAT_BACKEND=seatd || LIBSEAT_BACKEND=builtin; exec weston --debug --backend=drm-backend.so --renderer=pixman --socket=wayland-1" >>/run/pk/x-weston.log 2>&1 &
          echo $! > "$PIDF"
          k=0
          while [ $k -lt 25 ]; do
            [ -S "$RT/run/pk-x/wayland-1" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null && break
            sleep 1; k=$((k + 1))
          done
          if [ -S "$RT/run/pk-x/wayland-1" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
            printf '### PK: DESKTOP-PIXMAN-OK (software renderer, %ss) ###\n' "$k" > /dev/console 2>/dev/null
            say "desktop is up using the software renderer (expected on a VM without 3D acceleration)"
          else
            kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null || true
            rm -f "$PIDF" /run/pk/x-env
            printf '### PK: DESKTOP-NORENDER (weston died twice; log /run/pk/x-weston.log) ###\n' > /dev/console 2>/dev/null
            warn "weston does not render on this GPU/driver - falling back to Xvfb; view it with 'pk-desktop vnc 5900'"
            if rbin Xvfb; then start Xvfb; return $?; fi
            warn "Xvfb is not in the runtime either, so there is no GUI here (docs/VM-TEST.md #2b)"
            return 1
          fi
        fi
        if [ -x "$RT/usr/bin/weston-terminal" ] || [ -x "$RT/usr/bin/xterm" ]; then
          ( pk-chroot /bin/sh -c 'export XDG_RUNTIME_DIR=/run/pk-x WAYLAND_DISPLAY=wayland-1; cd; [ -x /usr/bin/weston-terminal ] && exec /usr/bin/weston-terminal; [ -x /usr/bin/xterm ] && exec env -u WAYLAND_DISPLAY XDG_RUNTIME_DIR=/run/pk-x DISPLAY= /usr/bin/xterm' >>/run/pk/x-weston.log 2>&1 ) &
          : > /run/pk/x-term 2>/dev/null
          say "launched a terminal (weston-terminal/xterm) - the desktop should be visible on screen"
        fi
        [ "${hasdrm:-1}" = 1 ] || warn "weston is HEADLESS: no physical screen -> use 'pk-desktop vnc 5900' or change the VM graphics device (docs/VM-TEST.md #2b)"
      else
        warn "weston's socket never appeared - reason: $(tail -3 /run/pk/x-weston.log 2>/dev/null | tr '\n' '|' | head -c 200)"
        kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null || true
        rm -f "$PIDF"
        if rbin Xvfb; then say "fallback: Xvfb"; start Xvfb; return $?; fi
        rm -f /run/pk/x-env
        return 1
      fi
      ;;
    Xorg)
      say "X11 server :0 (DRM/KMS) start"
      pk-chroot /bin/sh -c 'exec Xorg :0 -ac vt7' >"$LOGF" 2>&1 &
      echo $! > "$PIDF"
      printf 'DISPLAY=:0\n' > "$ENVR"
      ;;
    Xvfb)
      say "headless X11 (:0, 1280x800x24)"
      pk-chroot /bin/sh -c 'exec Xvfb :0 -screen 0 1280x800x24' >"$LOGF" 2>&1 &
      echo $! > "$PIDF"
      j=0
      while [ $j -lt 20 ]; do
        [ -e "$RT/tmp/.X11-unix/X0" ] && break
        sleep 1; j=$((j + 1))
      done
      if [ -e "$RT/tmp/.X11-unix/X0" ]; then
        printf 'DISPLAY=:0\n' > "$ENVR"
        say "Xvfb ready (:0, ${j}s)"
      else
        warn "Xvfb did not become ready (tail $LOGF)"; rm -f "$ENVR"; return 1
      fi
      ;;
    none|'')
      say "no display server in the runtime (weston/Xorg/Xvfb). Install one:"
      say "  pk-get install -y weston xterm        # Wayland, DRM/KMS par direct"
      say "  pk-get install -y xvfb x11vnc         # headless + VNC"
      say "  pk-get install -y xserver-xorg xterm  # X11 (intel/amd/nouveau/fbdev)"
      exit 65 ;;
    *) say "unknown server: $want (weston|Xorg|Xvfb)"; exit 1 ;;
  esac
  i=0
  while [ $i -lt 20 ]; do
    [ -s "$ENVR" ] && break
    sleep 1; i=$((i + 1))
  done
  . "$ENVR" 2>/dev/null || true
  say "env: $ENVR (apps should be started with pk-run --gui)"
  return 0
}

status() {
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
    echo "pk-x: session running (pid $(cat "$PIDF"))"$PIDF"))"
    [ -r "$ENVR" ] && sed 's/^/  /' "$ENVR"
  else
    echo "pk-x: no session.  pk-x start"
  fi
  [ -s "$LOGF" ] && { echo "  last log:"; tail -6 "$LOGF" | sed 's/^/    /'; }
}

stop() {
  [ -f "$PIDF" ] && { kill "$(cat "$PIDF")" 2>/dev/null; rm -f "$PIDF"; }
  pk-chroot /bin/sh -c 'pkill -f "weston|Xvfb|Xorg" 2>/dev/null' 2>/dev/null || true
  rm -f "$ENVR"
  say "stopped"
}

case "${1:-status}" in
  start) shift; start "${1:-auto}" ;;
  stop)  shift; stop ;;
  status) status ;;
  *) echo "usage: pk-x [start [weston|Xorg|Xvfb]|stop|status]"; exit 1 ;;
esac
exit 0
