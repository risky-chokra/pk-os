#!/bin/sh
# pk's OS :: display server (GUI apps ke liye) - runtime ke andar weston/Xorg/Xvfb
#   pk-x start            # jo mile usse session uthao (weston -> Xorg -> Xvfb)
#   pk-x start weston     # specific
#   pk-x status | stop
# Phir:  pk-run --gui <app>
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
ENVR=/run/pk/x-env
PIDF=/run/pk/x.pid
LOGF=/run/pk/x.log
have() { command -v "$1" >/dev/null 2>&1; }
mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }
say() { printf 'pk-x: %s\n' "$*"; }
rbin() { [ -x "$RT/usr/bin/$1" ] || [ -x "$RT/bin/$1" ]; }

start() {
  want=${1:-auto}
  mounted "$RT" || { say "runtime attach nahi hai -> pk-runtime start"; exit 64; }
  # KMS device ke bina weston sirf 'headless' backend par chadhta hai -> session ready
  # dikhega par SCREEN PAR KUCH NAHI (log isi ko "desktop nahi aaya" kehte hain).
  # Isliye auto mode me /dev/dri/card* dekho: na ho to Xvfb (VNC-able) prefer karo.
  hasdrm=0
  for c in /dev/dri/card*; do [ -e "$c" ] && { hasdrm=1; break; }; done
  if [ "$want" = auto ] && [ "$hasdrm" = 0 ] && rbin Xvfb; then
    say "KMS device nahi (/dev/dri/card*) -> weston ki jagah Xvfb select kiya (screen par kuch nahi aayega; 'pk-desktop vnc 5900' se GUI dekho)"
    want=Xvfb
  fi
  [ "$want" = auto ] && for c in weston Xorg Xvfb; do rbin "$c" && { want=$c; break; }; done
  case "$want" in
    weston)
      for d in /dev/dri /dev/input; do
        [ -e "$d" ] && { mkdir -p "$RT$d"; mounted "$RT$d" || mount --bind "$d" "$RT$d" 2>/dev/null || true; }
      done
      mkdir -p "$RT/run/pk-x"; chmod 700 "$RT/run/pk-x"
      say "weston (Wayland) start - console switch: Ctrl+Alt+F7"
      pk-chroot /bin/sh -c 'mkdir -p /run/pk-x; chmod 700 /run/pk-x; export XDG_RUNTIME_DIR=/run/pk-x; exec weston --socket=wayland-1 --renderer=gl 2>/dev/null || exec weston --backend=drm-backend.so --socket=wayland-1 || exec weston --backend=headless --socket=wayland-1 || exec weston --backend=headless-backend.so --socket=wayland-1' >"$LOGF" 2>&1 &
      echo $! > "$PIDF"
      # socket ka wait: iske bina 'x-env' likh dena = jhootha success
      j=0
      while [ $j -lt 20 ]; do
        [ -S "$RT/run/pk-x/wayland-1" ] && break
        sleep 1; j=$((j + 1))
      done
      if [ -S "$RT/run/pk-x/wayland-1" ]; then
        # clients chroot ke andar chalte hain -> in-chroot path hi do
        printf 'WAYLAND_DISPLAY=wayland-1\nXDG_RUNTIME_DIR=/run/pk-x\nPK_XDG_RUNTIME_HOST=%s\nDISPLAY=\n' "$RT/run/pk-x" > /run/pk/x-env
        say "weston ready (socket: $RT/run/pk-x/wayland-1, ${j}s)"
        [ "$hasdrm" = 1 ] || warn "weston HEADLESS par chal raha hai: koi physical screen nahi. 'pk-x stop' ke baad 'pk-desktop vnc 5900' use karo, ya VM ka graphics device badlo (docs/VM-TEST.md #2b)"
      else
        warn "weston ka socket nahi aaya (/dev/dri ya GL nahi?) -> $(tail -2 "$LOGF" 2>/dev/null | tr '\n' '|' | cut -c1-90)"
        kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null || true
        rm -f "$PIDF"
        if rbin Xvfb; then say "fallback: Xvfb"; start Xvfb; return $?; fi
        rm -f /run/pk/x-env
        return 1
      fi
      ;;
    Xorg)
      say "X11 server :0 (DRM/KMS) start"
      pk-chroot /bin/sh -c 'exec Xorg :0 -ac vt7' >"$LOGF" 2>&1 &
      echo $! > "$PIDF"
      printf 'DISPLAY=:0\n' > "$ENVR"
      ;;
    Xvfb)
      say "headless X11 (:0, 1280x800x24)"
      pk-chroot /bin/sh -c 'exec Xvfb :0 -screen 0 1280x800x24' >"$LOGF" 2>&1 &
      echo $! > "$PIDF"
      j=0
      while [ $j -lt 20 ]; do
        [ -e "$RT/tmp/.X11-unix/X0" ] && break
        sleep 1; j=$((j + 1))
      done
      if [ -e "$RT/tmp/.X11-unix/X0" ]; then
        printf 'DISPLAY=:0\n' > "$ENVR"
        say "Xvfb ready (:0, ${j}s)"
      else
        warn "Xvfb ready nahi hua (tail $LOGF)"; rm -f "$ENVR"; return 1
      fi
      ;;
    none|'')
      say "runtime me koi display server nahi (weston/Xorg/Xvfb). Install karo:"
      say "  pk-get install -y weston xterm        # Wayland, DRM/KMS par direct"
      say "  pk-get install -y xvfb x11vnc         # headless + VNC"
      say "  pk-get install -y xserver-xorg xterm  # X11 (intel/amd/nouveau/fbdev)"
      exit 65 ;;
    *) say "unknown server: $want (weston|Xorg|Xvfb)"; exit 1 ;;
  esac
  i=0
  while [ $i -lt 20 ]; do
    [ -s "$ENVR" ] && break
    sleep 1; i=$((i + 1))
  done
  . "$ENVR" 2>/dev/null || true
  say "env: $ENVR (apps ke liye pk-run --gui use karo)"
  return 0
}

status() {
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
    echo "pk-x: session chal raha hai (pid $(cat "$PIDF"))"
    [ -r "$ENVR" ] && sed 's/^/  /' "$ENVR"
  else
    echo "pk-x: koi session nahi.  pk-x start"
  fi
  [ -s "$LOGF" ] && { echo "  last log:"; tail -6 "$LOGF" | sed 's/^/    /'; }
}

stop() {
  [ -f "$PIDF" ] && { kill "$(cat "$PIDF")" 2>/dev/null; rm -f "$PIDF"; }
  pk-chroot /bin/sh -c 'pkill -f "weston|Xvfb|Xorg" 2>/dev/null' 2>/dev/null || true
  rm -f "$ENVR"
  say "band kiya"
}

case "${1:-status}" in
  start) shift; start "${1:-auto}" ;;
  stop)  shift; stop ;;
  status) status ;;
  *) echo "usage: pk-x [start [weston|Xorg|Xvfb]|stop|status]"; exit 1 ;;
esac
exit 0
