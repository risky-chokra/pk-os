# pk's OS defaults (pk-boot reads it before boot completes)
# note: ${VAR:-default} pattern -> the value from kernel cmdline/boot.env wins
PK_DHCP=${PK_DHCP:-no}    # yes = get IP via DHCP at boot
PK_SSH=${PK_SSH:-no}     # yes = dropbear SSH server start
PK_ISSUE=${PK_ISSUE:-yes}

# default mode of the CPU/IO/IPC tuning hook (S60tune): '' (off) | report | desktop | hybrid
# boot option pk_tune=... overrides this. desktop = governor/EPP + IO scheduler
# + sysctls + cgroup weights (apps=200 / bg=20); hybrid = detect P/E cores and pin daemons
# to efficiency cores. Manual: pk-tune report | pk-tune desktop | pk-tune undo
PK_TUNE=

# swap: from boot option pk_swap=<MB>|auto|off (or the default here). '' = do not touch swap at boot.
# auto = RAM/2 (clamped between 1 GB and 8 GB). In live, / is tmpfs/overlay -> there it
# is skipped deliberately (else swap = eating RAM); on installed systems (/var/tmp) or
# PK-PERSIST (/persistence), a swapfile is created and swapon'd.
# Manual: pk-tune swap 6144  |  pk-tune swap 0 (off)
PK_SWAP=${PK_SWAP:-}
