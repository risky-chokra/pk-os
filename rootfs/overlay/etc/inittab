# pk's OS :: /etc/inittab  (busybox init)
#
# id:runlevels:action:process
::sysinit:/sbin/pk-boot
tty1::respawn:/sbin/pk-console tty1
tty2::respawn:/sbin/pk-console tty2
tty3::respawn:/sbin/pk-console tty3
tty4::respawn:/sbin/pk-console tty4
# serial console (no effect on laptops: sleeps 120s if no device is found)
ttyS0::respawn:/sbin/pk-console ttyS0
# poweroff/reboot via ctrl-alt-del (handy for live demos)
::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/pk-halt
