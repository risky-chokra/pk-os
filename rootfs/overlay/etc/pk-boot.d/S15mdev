#!/bin/sh
# pk's OS boot hook :: dynamic device/node + driver management (busybox mdev)
#   default: ON   (to disable, boot option: pk_mdev=off  or  nomdev)
#
# Do not trust the old /proc/sys/kernel/hotplug helper interface on modern kernels (>=6.5);
# so run a netlink listener (`uevent mdev`) + coldplug (`mdev -s`) here instead.
# /etc/mdev/hotplug.sh runs on every uevent -> modprobe $MODALIAS
# (drivers as soon as USB wifi/ethernet/storage arrives) and DHCP too if a NIC appears (with PK_DHCP=yes).
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
say()  { printf 'pk-boot(mdev): %s\n' "$*"; }
mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; ( printf '%s\n' "$*" > /dev/kmsg ) 2>/dev/null; }
have() { command -v "$1" >/dev/null 2>&1; }

for a in $(cat /proc/cmdline 2>/dev/null); do
  case "$a" in pk_mdev=off|nomdev) say "disabled (pk_mdev=off)"; exit 0 ;; esac
done

if [ ! -x /bin/mdev ] && ! have mdev; then
  say "busybox mdev applet missing - skipping this hook"
  mark "MDEV-SKIP (no mdev applet)"
  exit 0
fi

mkdir -p /etc/mdev 2>/dev/null
cat > /etc/mdev/hotplug.sh <<'HOOK'
#!/bin/sh
# runs via /etc/mdev.conf @action; mdev sets the vars
case "${ACTION:-add}" in
  add)
    [ -n "${MODALIAS:-}" ] && modprobe -q "$MODALIAS" 2>/dev/null
    # NIC appeared but no IP? just a reminder - only S20net/pk-net controls DHCP
    # (running pk-net from here used to race: the hook's udhcpc
    # grabbed the pidfile, then died -> NET-FAIL).
    if [ -n "${INTERFACE:-}" ]; then
      cnt=$(ip -4 addr show "$INTERFACE" 2>/dev/null | grep -c 'inet ')
      if [ "${cnt:-0}" = 0 ]; then
        printf 'pk-boot(mdev): NIC %s added but no IP - run `pk-net dhcp`\n' "$INTERFACE" > /dev/kmsg 2>/dev/null
      fi
    fi
    ;;
esac
exit 0
HOOK
chmod 755 /etc/mdev/hotplug.sh 2>/dev/null

if [ ! -f /etc/mdev.conf ]; then
  cat > /etc/mdev.conf <<'CONF'
# busybox mdev: /dev nodes + add-action hook (@)
console        0:5      600
fb0            0:44     660
input/.*       0:0      600
tty[0-9]*      0:5      666
.*             0:0      666   @/etc/mdev/hotplug.sh
CONF
fi

say "coldplug: /dev scan (mdev -s)"
busybox mdev -s >/dev/null 2>&1
rc=$?

# set group/mode here for nodes mdev does not touch (devtmpfs already created them):
# otherwise /dev/dri, /dev/snd, /dev/input stay root-only and
# normal users get no GPU/sound/keyboard. (GPU drivers load *later*, so
# S99zdisplay re-runs this.)
if have pk-devperms; then pk-devperms; fi

lis=0
if [ -x /bin/uevent ] || have uevent; then
  ( setsid busybox uevent busybox mdev >/dev/null 2>&1 & ) 2>/dev/null && lis=1
fi
# also fill the old interface if present (harmless bonus)
if [ -e /proc/sys/kernel/hotplug ]; then
  printf '/bin/mdev\n' > /proc/sys/kernel/hotplug 2>/dev/null || true
fi

if [ "$lis" = 1 ]; then
  say "mdev ready (uevent listener on, coldplug rc=$rc)"
  mark "MDEV-OK (uevent listener + coldplug, rc=$rc)"
else
  say "mdev ready (coldplug only - no uevent applet)"
  mark "MDEV-COLDPLUG (rc=$rc)"
fi
exit 0
