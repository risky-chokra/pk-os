#!/bin/sh
# pk's OS boot hook :: seatd session manager uthao (GUI/weston iske upar chalta hai)
#   pk_seatd=off se band; runtime na ho to apne aap skip (base ISO prabhavit nahi)
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
for a in $(cat /proc/cmdline 2>/dev/null); do
  case "$a" in pk_seatd=off) printf 'pk-seatd-hook: band (pk_seatd=off)\n'; exit 0 ;; esac
done
[ -x /usr/bin/pk-seatd ] || exit 0
/usr/bin/pk-seatd start
exit 0
