#!/bin/sh
# pk's OS boot hook :: FINAL display probe (after mdev/runtime) + GPU driver ensure
# ---------------------------------------------------------------------------
# S08display runs very early (at that time /dev/dri does not exist yet), so it
# always wrote 'fb=0 drm=0' - which gave log readers the wrong "display died"
# signal. This hook re-checks after the work finishes:
#   1) explicitly loads known GPU KMS drivers for the display class
#      (do not rely on mdev coldplug - in VM/VBox uevents are often late/missing)
#   2) updates /run/pk/display.txt and the /etc/motd status line with FINAL numbers
#   3) marker: ### PK: DISPLAY-KMS (drm=N driver=X) ###  or ### PK: DISPLAY-TEXTONLY ###
#      (TEXTONLY means text works on screen but there is no device for a weston/KMS session
#       - then use 'pk-desktop vnc' or GRUB's 'v' safe-graphics entry)
# If it ever fails, boot continues: no set -e, everything guarded, exit 0.
# To disable: pk_display=off (this gets skipped along with S08display)
# ---------------------------------------------------------------------------
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
[ "${pk_display:-}" = off ] && exit 0
grep -q 'pk_display=off' /proc/cmdline 2>/dev/null && exit 0

mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; ( printf '%s\n' "$*" > /dev/kmsg ) 2>/dev/null; }
say() { printf 'pk-display-late: %s\n' "$*"; }

# --- 1) GPU drivers: small, targeted set (only what is in live /lib/modules) --
# Names must match Debian's module file names: there is no module named 'bochs-drm'
# in this kernel at all (the file is tiny/bochs.ko.xz) -> I first modprobed with the wrong
# name, which is why drm=0 kept coming even on -vga std.
GPU="vmwgfx vboxvideo qxl bochs cirrus virtio_gpu ast mgag200 i915 radeon nouveau vga16fb"
need=0
for m in $GPU; do
  [ -d /sys/module/$m ] && { need=1; break; }
done
if [ "$need" = 0 ]; then
  # only modprobe when a display-class PCI device is visible (not blindly)
  disp=0
  for c in /sys/bus/pci/devices/*/class; do
    cl=$(cat "$c" 2>/dev/null) || continue
    case "$cl" in 0x0300*|0x0301*|0x0302*|0x0380*) disp=1; break ;; esac
  done
  if [ "$disp" = 1 ]; then
    for m in $GPU; do
      modprobe -q "$m" 2>/dev/null && say "driver $m loaded"
    done
    i=0
    while [ $i -lt 5 ]; do
      ls /dev/dri/card* >/dev/null 2>&1 && break
      usleep 300000 2>/dev/null || sleep 1
      i=$((i + 1))
    done
  fi
fi

# a GPU driver just loaded -> new /dev/dri/card* appeared: perms are set right here
command -v pk-devperms >/dev/null 2>&1 && pk-devperms 2>/dev/null

# --- 2) final numbers ----------------------------------------------------------------
fbn=$(ls /dev/fb* 2>/dev/null | wc -l | tr -d ' ')
drm=$(ls /dev/dri/card* 2>/dev/null | grep -c 'card[0-9]*$')
[ -n "$drm" ] || drm=0
[ -n "$fbn" ] || fbn=0
drv=none
for u in /sys/class/drm/card*/device/uevent; do
  [ -f "$u" ] || continue
  d=$(sed -n 's/^DRIVER=//p' "$u" 2>/dev/null | head -1)
  [ -n "$d" ] && { drv="$d"; break; }
done
con=$(sed -n 's/^[[:space:]]*//;s/[[:space:]]*$//p' /proc/consoles 2>/dev/null | awk '{printf "%s ",$1}')
line="screen console ok (consoles:${con:-none}) fb=$fbn drm=$drm driver=$drv blank=off"

mkdir -p /run/pk 2>/dev/null
printf '%s\n' "$line" > /run/pk/display.txt 2>/dev/null || true

# motd's first line is [ pk-display-status ] -> replace it with FINAL
if [ -f /etc/motd ] && head -1 /etc/motd 2>/dev/null | grep -qs 'pk-display-status'; then
  tmp=/run/pk/motd.$$
  { printf '[ pk-display-status ] %s (final)\n' "$line"; sed '1d' /etc/motd; } > "$tmp" 2>/dev/null \
    && cat "$tmp" > /etc/motd 2>/dev/null
  rm -f "$tmp" 2>/dev/null || true
fi
[ -w /dev/tty1 ] && printf 'pk'"'"'s OS: final display check -> fb=%s drm=%s driver=%s\n' "$fbn" "$drm" "$drv" > /dev/tty1 2>/dev/null

# --- 3) honest verdict for the desktop -------------------------------------------------
if [ "$drm" -gt 0 ] 2>/dev/null; then
  mark "DISPLAY-KMS (drm=$drm driver=$drv fb=$fbn)"
  say "KMS device ready: weston can get /dev/dri/card0 (driver $drv)"
else
  if grep -q 'pk_desktop=1\|pk_desktop=on' /proc/cmdline 2>/dev/null; then
    say "pk_desktop=1 but no KMS device -> the desktop will run on Xvfb, not on the panel; view it with 'pk-desktop vnc 5900'"
  fi
  mark "DISPLAY-TEXTONLY (fb=$fbn drm=0; the text console is fine, but there is no driver for weston/KMS)"
fi
exit 0
