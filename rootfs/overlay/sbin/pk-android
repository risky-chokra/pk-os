#!/bin/sh
# pk's OS :: the Android (.apk) route - what is needed, what exists, how to get there
#   pk-android doctor            state of binder/ashmem/kvm/waydroid
#   pk-android enable            try to mount /dev/binderfs (if the kernel supports it)
#   pk-android install <apk>     unpack the apk + waydroid/greenlight setup instructions
#   pk-android kernel-frag       the config fragment for your own kernel (make kernel)
#   pk-android list              android containers installed in the runtime
#
# Fact: an Android app = the Android HAL (binderfs/ion/ashmem) + the ART runtime on the
# Linux kernel. So an .apk needs two things: (1) CONFIG_ANDROID_BINDERFS=y in the kernel
# (the host kernel we ship has none), (2) a waydroid/GSI image. This script gives exactly
# those steps and does whatever is possible right now.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
APPS=${PK_APPS_DIR:-/opt/pk/apps}
have() { command -v "$1" >/dev/null 2>&1; }
say()  { printf 'pk-android: %s\n' "$*"; }
warn() { printf 'pk-android: %s\n' "$*" >&2; }
mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; ( printf '%s\n' "$*" > /dev/kmsg ) 2>/dev/null; }
runtime_ok() { grep -q " $RT " /proc/mounts 2>/dev/null && [ -d "$RT/usr" ]; }

has_binder() {
  [ -e /dev/binder ] || [ -e /dev/binderfs ] || grep -q binderfs /proc/filesystems 2>/dev/null
}
has_ashmem() {
  [ -e /dev/ashmem ] || grep -q ashmem /proc/kallsyms 2>/dev/null || grep -q 'CONFIG_ASHMEM=y' /boot/config-$(uname -r) 2>/dev/null
}

doctor() {
  printf 'pk-android doctor (kernel %s)\n' "$(uname -r)"
  if has_binder; then printf '  binder/binderfs : HAAN\n'; else printf ' binder/binderfs : NAHI <- blocker #1 (kernel rebuild required)\n'; fi
  if has_ashmem; then printf '  ashmem          : HAAN\n'; else printf ' ashmem : not (memfd use may be, waydroid config me)\n'; fi
  if [ -e /dev/kvm ]; then printf ' /dev/kvm : yes (emulator/guest tez)\n'; else printf ' /dev/kvm : not\n'; fi
  if runtime_ok; then printf '  runtime         : attached\n'; else printf ' runtime : not laga (pk-runtime start)\n'; fi
  if runtime_ok && { [ -x "$RT/usr/bin/waydroid" ] || [ -e "$RT/usr/bin/waydroid" ]; }; then
    printf '  waydroid        : installed (runtime me)\n'
  else
    printf ' waydroid : not -> pk-get install -y waydroid lxc\n'
  fi
  BR=no; WD=no
  has_binder && BR=yes
  { [ -x "$RT/usr/bin/waydroid" ] || [ -e "$RT/usr/bin/waydroid" ]; } && WD=yes
  if [ "$BR" = yes ] && [ "$WD" = yes ]; then
    mark "ANDROID-READY"; printf '\n ready: pk-android init then pk-run --install <apk>\n'
  else
    mark "ANDROID-BLOCKED (binderfs=${BR:-no} waydroid=${WD:-no})"
    printf '\n abhi .apk native not run. Do option:\n'
    printf ' A) own kernel: make kernel (pk-android kernel-frag dekho) -> then ye test\n'
    printf ' B) Android-x86 / Waydroid guest: pk-vm new droid --size=20G (QEMU, slow on run)\n'
  fi
  return 0
}

do_enable() {
  mkdir -p /dev/binderfs 2>/dev/null
  if grep -q binderfs /proc/filesystems 2>/dev/null; then
    if mount -t binder binder /dev/binderfs 2>/dev/null; then
      say "/dev/binderfs is mounted"; mark "ANDROID-BINDERFS-OK"; return 0
    fi
    say "mount fail (perms?)"; mark "ANDROID-BINDERFS-FAIL"; return 1
  fi
  warn "the kernel has no binderfs support (needs CONFIG_ANDROID_BINDERFS=y)"
  warn "there is no /dev/binder either -> Android apps cannot run on this kernel"
  mark "ANDROID-BINDERFS-NOSUPPORT"
  return 1
}

do_install() {
  apk=${1:-}
  [ -n "$apk" ] && [ -f "$apk" ] || { echo "usage: pk-android install <app.apk>"; return 1; }
  d=$APPS/apk
  mkdir -p "$d" 2>/dev/null || { warn "$APPS is not writable (attach the runtime)"; return 71; }
  if have unzip; then
    unzip -q -o "$apk" -d "$d/$(basename "$apk" .apk)" >/dev/null 2>&1 || warn "unzip fail"
  else
    warn "no unzip (not in the base image) - only recording the file"
  fi
  name=$(basename "$apk" .apk)
  say "apk extracted: $d/$name  (AndroidManifest is binary XML, so we cannot read package/activity ourselves)"
  BR=no; WD=no
  has_binder && BR=yes
  { [ -x "$RT/usr/bin/waydroid" ] || [ -e "$RT/usr/bin/waydroid" ]; } && WD=yes
  if [ "$BR" = yes ] && [ "$WD" = yes ]; then
    say "binder + waydroid present -> installing:"
    pk-chroot /usr/bin/waydroid app install "$RT${d#/}/$name.apk" 2>&1 | tail -3
    return $?
  fi
  cat <<TXT
  Chalane ke liye chahiye: (1) kernel me binderfs, (2) waydroid + GSI image.
  Commands:
    pk-android enable            # binderfs try
    pk-get install -y waydroid lxc
    sudo waydroid init -s GAPPS -f <gsi.img.xz>     # host/real PC par
    pk-run --install $apk                            # phir ye
TXT
  mark "ANDROID-INSTALL-PLANNED ($name)"
  return 0
}

kernel_frag() {
  cat <<'TXT'
# pk's OS :: Android-container kernel fragment (make kernel me ye add ho jaata hai)
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y           # (6.x me built-in)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
# Waydroid/LXC ko ye bhi chahiye:
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
TXT
}

case "${1:-}" in
  doctor|check|"") doctor ;;
  enable|binderfs) do_enable ;;
  install) shift; do_install "${1:-}" ;;
  list)
    echo "apk extracts: $(ls "$APPS/apk" 2>/dev/null | tr '\n' ' ')"
    if runtime_ok && [ -x "$RT/usr/bin/waydroid" ]; then pk-chroot /usr/bin/waydroid status 2>&1 | head -5; fi ;;
  kernel-frag|config) kernel_frag ;;
  --help|-h) sed -n '2,12p' "$0" ;;
  *) warn "unknown: $1"; exit 1 ;;
esac
