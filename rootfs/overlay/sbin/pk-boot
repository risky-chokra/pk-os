#!/bin/sh
# pk's OS :: sysinit  (started from inittab ::sysinit)
# fixes mounts, hostname, banner, network/ssh, install/autostep; then inittab spawns the
# getty/shell.
# shellcheck shell=sh disable=SC3030,SC2086
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
umask 022

have() { command -v "$1" >/dev/null 2>&1; }
has()  { grep -q -- "$1" /proc/cmdline 2>/dev/null; }
note() { printf 'pk-boot: %s\n' "$*"; }
say()  { printf 'pk-boot: %s\n' "$*"; }   # old blocks used say but it was never defined
                              # -> "pk-boot: line N: say: not found" everywhere in the boot log (latent bug).

dbg()  { [ "$PK_DEBUG" = 1 ] && printf 'pk-boot(dbg): %s\n' "$*"; return 0; }

# keep kernel messages off the console (boot stays clean)
dmesg -n 1 2>/dev/null

mkdir -p /run/lock /run/network /var/log /var/tmp /tmp /dev/shm /mnt /media
[ -L /etc/mtab ] || ln -sf /proc/mounts /etc/mtab 2>/dev/null

MODE=live
[ -f /run/pk/mode ] && MODE=$(cat /run/pk/mode)
PK_DEBUG=0
grep -q pk_debug /proc/cmdline && PK_DEBUG=1
[ "$PK_DEBUG" = 1 ] && dmesg -n 7 2>/dev/null

# hostname
[ -f /etc/hostname ] && hostname "$(cat /etc/hostname)"

# live vs installed: password prompt by default in installed systems
if [ -e /etc/pk-installed ] && ! grep -qE 'pk_autologin|swape_autologin' /proc/cmdline; then
  : > /run/pk/require-login
fi
[ "$MODE" = live ] && : > /run/pk/live

# console: UTF-8 + font (if shipped)
if have loadfont; then
  for f in /usr/share/consolefonts/Uni2-Fixed16.psf.gz /usr/share/consolefonts/Lat15-Terminus16.psf.gz; do
    [ -f "$f" ] && { zcat "$f" 2>/dev/null | loadfont 2>/dev/null && break; }
  done
fi
[ -f /etc/keymap ] && have loadkmap && loadkmap < /etc/keymap 2>/dev/null

# defaults file
PK_DHCP=no
PK_SSH=no
[ -f /etc/default/pk ] && . /etc/default/pk
[ -f /etc/default/swape ] && . /etc/default/swape 2>/dev/null   # legacy image
# legacy names (SwapeOS 1.0 images) -> new vars
[ -n "${SWAPE_DHCP:-}" ] && PK_DHCP=${PK_DHCP:-$SWAPE_DHCP}
[ -n "${SWAPE_SSH:-}" ]  && PK_SSH=${PK_SSH:-$SWAPE_SSH}
[ -n "${SWAPE_ISSUE:-}" ] && PK_ISSUE=${PK_ISSUE:-$SWAPE_ISSUE}
[ -f /run/pk/boot.env ] && . /run/pk/boot.env

# ------------------------------------------------------------------ network / ssh
# boot options can override config (files carry the ${VAR:-default} pattern)
[ "${NETCFG:-}" = dhcp ] && PK_DHCP=yes
export PK_DHCP PK_SSH
# (SSH/net hooks run only via S20net/S30ssh - do not start them again here)

# ------------------------------------------------------------------ boot hooks
for h in /etc/pk-boot.d/S[0-9][0-9]*; do
  [ -x "$h" ] || continue
  dbg "hook: $h"
  "$h" 2>&1 | sed 's/^/[hook] /'
done

# ------------------------------------------------------------------ banner
{
  printf '\n'
  [ -f /etc/motd ] && cat /etc/motd
  printf '\n### PK: BOOT-OK mode=%s kernel=%s media=%s ###\n' \
    "$MODE" "$(uname -r)" "$(cat /run/pk/media 2>/dev/null || cat /run/pk/rootdev 2>/dev/null || echo installed?)"
} > /dev/console 2>/dev/null || true

# Wi-Fi (experimental): pk_wifi=<ssid>:<password>  (for laptops without ethernet)
WSPEC=$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | sed -n 's/^pk_wifi=//p' | head -1)
if [ -n "${WSPEC:-}" ] && command -v pk-wifi >/dev/null 2>&1; then
  wssid=${WSPEC%%:*}; wpw=${WSPEC#*:}
  [ "$wpw" = "$WSPEC" ] && wpw=""
  ip0=$(ip -4 addr show 2>/dev/null | awk '/inet /{if($2!~/^127\./){print $2; exit}}')
  if [ -n "${ip0:-}" ]; then
    say "pk_wifi: already have an IP ($ip0) - skipping wifi"
  else
    say "pk_wifi: trying to connect to '$wssid' (experimental)"
    pk-wifi connect "$wssid" "$wpw" > /run/pk/wifi-boot.log 2>&1 || say "  wifi fail - detail: /run/pk/wifi-boot.log"
  fi
fi

# keymap (console + GUI) - pk_keymap=in
KMAP=$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | sed -n 's/^pk_keymap=//p' | head -1)
if [ -n "${KMAP:-}" ] && (command -v pk-keymap >/dev/null 2>&1); then
  pk-keymap "$KMAP" >/dev/null 2>&1 && say "keymap: $KMAP" || say "keymap '$KMAP' was only partly applied"
fi
# pendrive hardware check (for real-PC tests) - pk_check=1
if has pk_check=1 || has pk_check=on || has pk_check=gui; then
  # runtime attach (S50runtime hook) happens in the background -> wait a little, so
  # the runtime/apps lines do not come out empty in the report
  jw=0
  while [ $jw -lt 8 ]; do
    grep -q ' /opt/pk ' /proc/mounts 2>/dev/null && break
    sleep 1; jw=$((jw + 1))
  done
  ckargs="--save --verbose"
  if has pk_check=gui; then ckargs="$ckargs --gui"; fi
  say "running pk-check (waiting ${jw}s for the runtime; args: $ckargs)"
  pk-check $ckargs > /run/pk/check.out 2>&1
  fr=$(grep '^\[FAIL\]' /run/pk/check.out 2>/dev/null | tr '\n' '|' | cut -c1-180)
  [ -n "${fr:-}" ] && printf '### PK: CHECK-ROWS %s ###\n' "$fr" > /dev/console
  say "pk-check done (rc=$?) - full report: less /run/pk/check.txt"
fi
# ------------------------------------------------ user: pk_user=<name> [+ pk_userpw=<pw>]
# the "no user besides root" gap ends here: the boot option creates a user
# (if there is none) and sets tty1 autologin to it. In installed systems these
# values come from pk-install's --user/--user-password.
_pu=$(sed -n 's/.*pk_user=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null | head -1)
if [ -n "${_pu:-}" ] && [ "${_pu:-}" != root ]; then
  if ! grep -qs "^$_pu:" /etc/passwd; then
    _ppw=$(sed -n 's/.*pk_userpw=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null | head -1)
    say "user '$_pu' does not exist -> creating it with pk-user add"
    if [ -n "${_ppw:-}" ]; then
      pk-user add "$_pu" --password="$_ppw" >/run/pk/user-boot.log 2>&1
    else
      pk-user add "$_pu" >/run/pk/user-boot.log 2>&1 </dev/null
    fi
    note "  pk-user add rc=$? (detail: /run/pk/user-boot.log)"
  fi
  if grep -qs "^$_pu:" /etc/passwd; then
    mkdir -p /run/pk 2>/dev/null; printf '%s\n' "$_pu" > /run/pk/autologin 2>/dev/null
    note "tty1 autologin = $_pu"
    printf '### PK: USER-AUTOLOGIN (%s) ###\n' "$_pu" > /dev/console
  else
    printf '### PK: USER-ADD-FAIL (%s) ###\n' "$_pu" > /dev/console
  fi
fi

# ------------------------------------------------ seatd (session manager)
# weston needs logind to take VT + /dev/dri + /dev/input; in our live image
# there is no systemd, so seatd (inside the runtime) does that job. pk_seatd=off disables it.
if ! has pk_seatd=off; then
  if [ ! -S /opt/pk/run/seatd.sock ]; then
    note "pk-seatd start (weston session for)"
    pk-seatd start >/run/pk/seatd-boot.log 2>&1 || note "  seatd failed (detail: /run/pk/seatd-boot.log) - weston will try without seatd"
  fi
fi

# desktop session (for opening the apps-included ISO on a real PC) - pk_desktop=1
if has pk_desktop=1 || has pk_desktop=on; then
  note "pk-desktop start (weston/Xvfb; detail /run/pk/desktop.log)"
  pk-desktop start >/run/pk/desktop.log 2>&1 || note "pk-desktop fail (log: /run/pk/desktop.log)"
  # the answer to 'why did the desktop not come' should now be on screen: pk-x detail
  # used to stay buried in /run/pk/x.log and pk-desktop's in /run/pk/desktop.log.
  d_tail=$(tr '\n' '|' < /run/pk/x-weston.log 2>/dev/null | tail -c 220)
  [ -n "${d_tail:-}" ] || d_tail=$(tr '\n' '|' < /run/pk/x.log 2>/dev/null | tail -c 160)
  if grep -qs 'WAYLAND_DISPLAY' /run/pk/x-env 2>/dev/null; then
    printf 'pk-desktop: weston/Wayland session started (%s)\n' "${d_tail:-ok}" > /dev/console 2>/dev/null
  else
    printf '### PK: DESKTOP-XVFB (nothing on screen not; reason: %s) ###\n' "${d_tail:-no-log}" > /dev/console
    if [ -w /dev/tty1 ]; then
      { printf "\npk's OS: desktop session started on Xvfb (virtual - the screen stays blank; view it with 'pk-desktop vnc 5900')\n"
        printf "  reason: %s\n" "${d_tail:-no-log}"
        printf " GUI to view for: pk-desktop vnc 5900 (viewer host on , guest IP port 5900)\n"
        printf "  or choose a KMS graphics device for the VM: docs/VM-TEST.md #2b\n"
      } > /dev/tty1 2>/dev/null || true
    fi
  fi
  if has pk_check=1 || has pk_check=on || has pk_check=gui; then
    note "re-run after the desktop is up: pk-check --gui"
    pk-check --save --gui > /run/pk/check2.out 2>&1
  fi
fi
# ------------------------------------------------------------------ autoinstall (from the grub menu)
if [ -f /run/pk/boot.env ]; then
  . /run/pk/boot.env
  if [ -n "${INSTALLDEV:-}" ]; then
    note "autoinstall starting (target=$INSTALLDEV)"
    # an install run from a boot option is unattended -> always --yes
    # (only in 'ask' mode does the installer ask itself). Silent = into the output file.
    rc=0
    iopt="--yes"
    [ -n "${ROOTPW:-}" ] && iopt="$iopt --root-password=$ROOTPW"
    [ -n "${INSTUSER:-}" ] && iopt="$iopt --user=$INSTUSER"
    [ -n "${INSTUSERPW:-}" ] && iopt="$iopt --user-password=$INSTUSERPW"
    if [ "$INSTALLDEV" = ask ]; then
      echo "[install] interactive mode - pk-install will ask you itself" > /dev/console
      /sbin/pk-install --target= ; rc=$?
    elif [ "${SILENT:-0}" = 1 ]; then
      ilog=/run/pk-install.log
      sh -c "/sbin/pk-install --target=$INSTALLDEV $iopt > $ilog 2>&1"
      rc=$?
      echo "[install] rc=$rc logsize=$(wc -c < "$ilog" 2>&1)" > /dev/console
      echo "--- pk-install.log ---" > /dev/console
      tail -60 "$ilog" > /dev/console
      echo "--- end pk-install.log ---" > /dev/console
    else
      /sbin/pk-install --target="$INSTALLDEV" $iopt ; rc=$?
    fi
    echo "### PK: INSTALL-DONE rc=$rc ###" > /dev/console
    if [ "${HALT:-0}" = 1 ]; then
      echo "### PK: POWER-OFF ###" > /dev/console
      sync
      poweroff -f 2>/dev/null || poweroff
    fi
  fi
fi

# ------------------------------------------------------------------ self test (make test)
if has 'pk_selftest'; then
  echo "### PK: SELFTEST-BEGIN mode=$MODE ###"
  echo "selftest: kernel $(uname -r)  mode=$MODE  media=$(cat /run/pk/media 2>/dev/null || echo installed)"
  grep ' / ' /proc/mounts | sed 's|^|selftest: root = |'
  echo probe > /tmp/pk-probe && rm -f /tmp/pk-probe && echo "selftest: /tmp writable"
  echo probe > /run/pk-probe && rm -f /run/pk-probe && echo "selftest: /run writable"
  if [ -d /live-base ]; then
    echo "selftest: squashfs base mounted read-only"
    if touch /live-base/.should-fail 2>/dev/null; then echo "selftest: WARNING base writable?"; else echo "selftest: base is read-only (expected)"; fi
    rm -f /live-base/.should-fail 2>/dev/null
  fi
  [ -x /bin/busybox ] && echo "selftest: busybox $(/bin/busybox 2>/dev/null | head -1 | awk '{print $2}')"
  [ -e /live-iso/live/pk.sqfs ] && echo "selftest: live medium visible at /live-iso"
  [ -d /lib/modules ] && echo "selftest: /lib/modules present ($(ls /lib/modules 2>/dev/null | head -1))"
  # can installer + admin tools run? (the real test of dynamic linking / lib closure)
  depfail=""
  for t in parted blkid lsblk findmnt losetup mke2fs e2fsck mkfs.vfat tune2fs wipefs \
           grub-install grub-mkimage grub-probe tar gzip; do
    tp=$(command -v "$t" 2>/dev/null) || { depfail="$depfail $t(missing)"; continue; }
    "$t" --version >/dev/null 2>&1
    trc=$?
    # 127 = loader/lib not found / 126 = could not exec -> that is the real problem
    # (busybox applets give a usage error on --version, that is normal)
    if [ "$trc" = 127 ] || [ "$trc" = 126 ]; then depfail="$depfail $t(cant-exec:$tp)"; fi
  done
  if [ -z "$depfail" ]; then
    echo "### PK: DEPS-OK ###"
  else
    echo "### PK: DEPS-FAIL:$depfail ###"
    echo "pk: tools missing/broken:$depfail" > /dev/kmsg 2>/dev/null
  fi
  # network + ssh (they are async -> short wait; QEMU user-net gets 10.0.2.15)
  if [ "${PK_DHCP:-no}" = yes ]; then
    i=0
    while [ $i -lt 15 ]; do
      ip=$(ip -4 addr show 2>/dev/null | awk '/inet /{if($2!~/^127\./){split($2,a,"/");print a[1]; exit}}')
      [ -n "$ip" ] && break
      sleep 1; i=$((i + 1))
    done
  fi
  if [ "${PK_SSH:-no}" = yes ]; then
    i=0
    while [ $i -lt 15 ]; do
      pidof dropbear >/dev/null 2>&1 && break
      sleep 1; i=$((i + 1))
    done
  fi
  if [ -n "${ip:-}" ]; then echo "### PK: NET-OK ($ip) ###"
  elif [ "${PK_DHCP:-no}" = yes ]; then
    echo "### PK: NET-FAIL (DHCP got no IP) ###"
    echo "--- pk-net.log ---" >> /dev/console 2>/dev/null
    tail -8 /var/log/pk-net.log 2>/dev/null | sed 's/^/  net-log: /'
    echo "--- NIC ---" >> /dev/console 2>/dev/null
    ls /sys/class/net 2>&1 | sed 's/^/  ifaces: /' | head -4
    command -v modprobe >/dev/null 2>&1 && lsmod 2>/dev/null | sed -n 's/^\([a-z0-9_]*\).*/  mod: \1/p' | grep -iE "virtio_net|e1000|r8169|tg3|usb_lan" | head -3
  fi
  if pidof dropbear >/dev/null 2>&1; then echo "### PK: SSH-OK (dropbear :22) ###"
  elif [ "${PK_SSH:-no}" = yes ]; then echo "### PK: SSH-FAIL (dropbear did not start) ###"
    tail -5 /var/log/pk-ssh.log 2>/dev/null | sed 's/^/  ssh-log: /'; fi
  APPSGET=$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | sed -n 's/^pk_apps_get=//p')
  if [ -n "${APPSGET:-}" ]; then
    # let the net come up (for apt), then install + run
    j=0
    while [ $j -lt 20 ]; do
      ip2=$(ip -4 addr show 2>/dev/null | awk '/inet /{if($2!~/^127\./){print $2; exit}}')
      [ -n "${ip2:-}" ] && break
      sleep 1; j=$((j + 1))
    done
    note "pk_apps_get: try install + run in runtime (net=${ip2:-none}, in ${j}s)"
    for spec in $APPSGET; do
      pkg=${spec%%:*}; args=${spec#*:}
      [ "$args" = "$spec" ] && args=""
      note "  installing $pkg"
      if pk-get install -y -o "Acquire::Retries=2" "$pkg" > /run/pk/apps-get.log 2>&1; then
        found=""
        for d in /opt/pk/usr/bin /opt/pk/usr/games /opt/pk/bin /opt/pk/usr/local/bin /opt/pk/usr/sbin; do
          { [ -x "$d/$pkg" ] || [ -e "$d/$pkg" ] || [ -L "$d/$pkg" ]; } && { found=$d/$pkg; break; }
        done
        if [ -n "$found" ]; then
          # shellcheck disable=SC2086
          out=$(pk-run "$pkg" $args 2>&1 | head -3 | tr '\n' '|' | cut -c1-140)
          printf '### PK: APPS-GET-OK (%s) %s ###\n' "$pkg" "$out"
        else
          printf '### PK: APPS-GET-INSTALLED (%s) but no /usr/bin binary found ###\n' "$pkg"
        fi
      else
        printf '### PK: APPS-GET-FAIL (%s) %s ###\n' "$pkg" "$(tail -c 200 /run/pk/apps-get.log 2>/dev/null | tr '\n' '|')"
      fi
    done
  fi
  if [ -x /sbin/pk-run ]; then
    /sbin/pk-run --selftest >/run/pk/apps-selftest.log 2>&1
    rc=$?
    if [ "$rc" != 0 ]; then
      oneline=$(tail -c 900 /run/pk/apps-selftest.log 2>/dev/null | tr '\n' '|')
      printf '### PK: APPS-SELFTEST-LOG rc=%s %s ###\n' "$rc" "${oneline:-empty}" > /dev/console 2>/dev/null
      printf 'APPS-SELFTEST-LOG rc=%s %s\n' "$rc" "${oneline:-<khaali>}" > /dev/kmsg 2>/dev/null
    fi
  fi
  if [ -e /run/pk-persist-on ]; then
    if [ -f /root/.pk-persist-marker ]; then
      echo "### PK: PERSIST-KEPT ###"
    else
      echo "boot $(uname -r) at $(date 2>/dev/null)" > /root/.pk-persist-marker 2>/dev/null \
        && echo "### PK: PERSIST-WROTE ###" || echo "### PK: PERSIST-FAIL ###"
    fi
  fi
  # installed vs live login policy + shadow sanity (QA markers)
  rh=$(sed -n '1p' /etc/shadow 2>/dev/null | cut -d: -f2)
  case "$rh" in
    \$[56y]\$*) echo "### PK: PASSWD-OK (root hash type sha-$(printf %s "$rh" | cut -d\$ -f2)) ###" ;;
    ""|"*"|"!"|"*!") echo "### PK: PASSWD-LOCKED (root login disabled) ###" ;;
    *) echo "### PK: PASSWD-SKIP (hash field: $rh) ###" ;;
  esac
  if [ -f /etc/pk-installed ]; then
    if [ -f /run/pk/require-login ]; then
      echo "### PK: LOGIN-REQUIRED ###"
    else
      echo "### PK: LOGIN-REQUIRED-MISSING (installed system autologging in?!) ###"
    fi
  else
    echo "### PK: LIVE-AUTOLOGIN ###"
  fi
  echo "### PK: SELFTEST-OK ###"
fi

# ---------------------------------------------------------------- pk_run=<cmd> (diagnostics)
# to get answers to questions like "why the desktop did not appear / why this file is empty"
# run one command after boot, output on console. No space goes into kernel args,
# so write space as '+':
#   pk_run=cat+/run/pk/x-weston.log!ls+-l+/dev/dri
#   space = '+', command separator = '!'  (in GRUB config ';' is the command separator
#   -> writing ';' cuts kernel args short, this is product-level stuff)
# (the full output is also written to /run/pk/pk_run.out)
_pkrun=$(sed -n 's/.*pk_run=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null | head -1)
if [ -n "${_pkrun:-}" ]; then
  echo "### PK: RUN-START ###"
  sh -c "$(printf '%s' "$_pkrun" | tr '+' ' ' | tr '!' ';')" > /run/pk/pk_run.out 2>&1
  _rc=$?
  tail -40 /run/pk/pk_run.out 2>/dev/null | sed 's/^/[pk_run] /'
  printf '### PK: RUN-DONE rc=%s (full: /run/pk/pk_run.out) ###\n' "$_rc"
fi

if has 'pk_poweroff'; then
  echo "### PK: POWER-OFF-NOW ###"
  sync
  poweroff -f 2>/dev/null || poweroff -f
fi

exit 0
