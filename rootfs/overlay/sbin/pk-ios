#!/bin/sh
# pk's OS :: iOS / iPadOS apps - what is true, and how to actually get work done
#   pk-ios doctor              what this machine/runtime has available
#   pk-ios why                 one line: why it cannot run natively
#   pk-ios info <file.ipa>     open the .ipa/.app: bundle id, arch, minimum iOS
#   pk-ios extract <file.ipa> [dir]
#   pk-ios web <url> [name]    turn an iOS-only service into a desktop/kiosk app
#   pk-ios mac-guest [--run]   the QEMU macOS guest + Xcode iOS Simulator route
#   pk-ios darling [--setup]   Darling, for macOS (x86_64/arm64) Mach-O apps
#
# NOTE (said honestly): an iOS app = Mach-O + Apple's closed frameworks (UIKit/SwiftUI)
# + codesign + the XNU kernel. A Linux kernel cannot load Mach-O and there is no Linux
# port of UIKit -> "install an .ipa and run it" is not possible. The routes above are the
# ones that really work, and this script offers exactly those.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
APPS=${PK_APPS_DIR:-/opt/pk/apps}
HOME=${HOME:-/root}

have() { command -v "$1" >/dev/null 2>&1; }
say()  { printf 'pk-ios: %s\n' "$*"; }
warn() { printf 'pk-ios: %s\n' "$*" >&2; }
mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; ( printf '%s\n' "$*" > /dev/kmsg ) 2>/dev/null; }
runtime_ok() { grep -q " $RT " /proc/mounts 2>/dev/null && [ -d "$RT/usr" ]; }

why() {
  cat <<'TXT'
iOS apps Linux par native nahi chal sakti. Teen wajah:
  1) Binary format: Mach-O (arm64) -> Linux kernel ye execute nahi kar sakta (XNU chahiye)
  2) Frameworks: UIKit/SwiftUI/CoreAnimation closed-source hain, koi Linux port nahi
  3) Codesign + sandbox: iOS kernel-level entitlements maangta hai
Chalane ke *sachche* raaste (isi order me acche):
  A) Service use karo, app nahi:  pk-ios web https://...      (browser kiosk launcher)
  B) macOS guest me Xcode Simulator:  pk-ios mac-guest         (QEMU + legal macOS)
  C) macOS console binaries (iOS nahi): Darling -> pk-ios darling
  D) Cross-platform rewrite: Flutter/React Native/Tauri -> yahan Linux app ke taur par chalti hai
TXT
}

plist_get() { # <file> <key>
  f=$1; k=$2
  if [ "$(head -c8 "$f" 2>/dev/null | od -An -c | tr -d ' \n')" = 'bplist00' ]; then
    tr -c '[:print:]' '\n' < "$f" 2>/dev/null | awk -v k="$k" 'p{print; p=0} $0==k{p=1}' | head -1
  else
    awk -v k="$k" '
      index($0, "<key>" k "</key>") { f=1; next }
      f {
        line=$0
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        if (line ~ /^<array>/ || line ~ /<array>/) {   # <array> ke andar values
          buf=line; got=0
          while (buf !~ /<\/array>/ && (getline nxt) > 0) {
            buf = buf " " nxt
            if (nxt ~ /<\/array>/) { got=1; break }
          }
          sub(/^[^>]*<array>/, " ", buf)
          gsub(/<[^>]*>|[ \t]+/, " ", buf)
          gsub(/^[ ]+|[ ]+$|, /, "", buf)
          gsub(/  +/, " ", buf)
          if (buf != "") { print buf; exit }
          next
        }
        sub(/^[ \t]*<string>[ \t]*/, "", line); sub(/[ \t]*<\/string>[ \t]*$/, "", line)
        if (line != "" && line !~ /^</) { print line; exit }
      }
    ' "$f" 2>/dev/null | head -1
  fi
}

# Mach-O header se arch nikaalo
macho_arch() { # <file>
  f=$1
  [ -f "$f" ] || return 1
  m=$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')
  pre=''
  case "$m" in
    feedfacf*|cffaedfe*|feedface*|cefaedfe*)
      ct=$(od -An -tx1 -j4 -N4 "$f" 2>/dev/null | tr -d ' \n') ;;
    cafebabe*|bebafeca*)
      # fat binary: nfat_HDR ke baad pehli entry ka cputype (offset 12)
      ct=$(od -An -tx1 -j12 -N4 "$f" 2>/dev/null | tr -d ' \n')
      pre='universal/' ;;
    *) return 1 ;;
  esac
  case "$ct" in
    0c000001|0100000c) printf '%sarm64\n' "$pre" ;;
    0c800001|0100800c) printf '%sarm64e\n' "$pre" ;;
    07000001|01000007) printf '%sarmv7\n' "$pre" ;;
    0700000c|0c000007) printf '%sx86_64\n' "$pre" ;;
    01000006|06000001) printf '%si386/x86\n' "$pre" ;;
    0200000c|0c000002) printf '%sarm64_32 (watch)\n' "$pre" ;;
    *) printf '%sarch:%s\n' "$pre" "${ct:-?}" ;;
  esac
}

do_info() { # <ipa|app>
  src=$1
  [ -f "$src" ] || [ -d "$src" ] || { warn "file not found: $src"; return 1; }
  work=/tmp/pk-ios.$$
  mkdir -p "$work"
  app=""
  case "$src" in
    *.ipa|*.zip|*.app.zip)
      have unzip || { warn "opening an '.ipa' needs 'unzip'"; rm -rf "$work"; return 70; }
      say "opening the ipa (zip): $src"
      unzip -q -o "$src" -d "$work" >/dev/null 2>&1
      app=$(find "$work" -maxdepth 3 -type d -name '*.app' 2>/dev/null | head -1)
      ;;
    *.app)
      app=$src
      ;;
    *)
      say "the extension is not conclusive; looking for the payload"
      if have unzip; then unzip -q -o "$src" -d "$work" >/dev/null 2>&1 || true; fi
      app=$(find "$work" -maxdepth 3 -type d -name '*.app' 2>/dev/null | head -1)
      ;;
  esac
  if [ -z "$app" ]; then
    warn "no Payload/*.app (this may be an App Store .ipa - a FairPlay-encrypted IPA cannot be opened on any OS)"
    mark "IOS-INFO-SKIP (no payload)"
    rm -rf "$work"; return 1
  fi
  pl="$app/Info.plist"
  exe=""
  [ -f "$pl" ] && exe="$app/$(plist_get "$pl" CFBundleExecutable)"
  printf 'app           : %s\n' "$(basename "$app")"
  printf 'bundle id     : %s\n' "$(plist_get "$pl" CFBundleIdentifier)"
  printf 'display name  : %s\n' "$(plist_get "$pl" CFBundleDisplayName)"
  printf 'executable    : %s\n' "$(basename "${exe:-?}")"
  printf 'min iOS       : %s\n' "$(plist_get "$pl" MinimumOSVersion)"
  printf 'device family : %s  (1=iphone 2=ipad)\n' "$(plist_get "$pl" UIDeviceFamily)"
  printf 'platform      : %s\n' "$(plist_get "$pl" DTPlatformName)"
  if [ -n "$exe" ] && [ -f "$exe" ]; then
    printf 'binary arch   : %s\n' "$(macho_arch "$exe" || echo '(parse nahi)')"
  fi
  printf '\nkya hoga       : CHALEGA NA (iOS/UKit runtime chahiye). Kya kar sakte ho:\n'
  printf '  - web app bana do : pk-ios web <url> %s\n' "$(plist_get "$pl" CFBundleDisplayName | tr -d ' ' | tr 'A-Z' 'a-z' | cut -c1-20)"
  printf '  - macOS guest me Xcode Simulator (pk-ios mac-guest)\n'
  printf '  - agar source code hai -> Flutter/React Native/Tauri se yahan native build\n'
  mark "IOS-INFO-OK $(basename "$app")"
  ls "$app" 2>/dev/null | sed 's/^/  file: /' | head -12
  printf '  (extracted: %s)\n' "$work"
  return 0
}

do_extract() {
  src=$1; d=${2:-${HOME}/pk-ios-apps}
  have unzip || { warn "unzip is required"; return 70; }
  mkdir -p "$d"
  unzip -q -o "$src" -d "$d" && say "extracted -> $d/Payload" || { warn "unzip fail"; return 70; }
}

do_web() {
  url=${1:-}; name=${2:-}
  [ -n "$url" ] || { echo "usage: pk-ios web <url> [name] [--kiosk]"; return 1; }
  case "$url" in
    http://*|https://*) : ;;
    *) url="https://$url" ;;
  esac
  if [ -z "$name" ]; then
    name=$(printf '%s' "$url" | sed -e 's|https\?://||' -e 's|/.*||' | tr -c 'a-zA-Z0-9' '-' | sed 's/^-*//;s/-*$//' | tr 'A-Z' 'a-z' | cut -c1-24)
  fi
  [ -n "$name" ] || name=iosweb
  b=''
  for c in firefox-esr firefox epiphany chromium chromium-browser surf luakit; do
    if runtime_ok && [ -x "$RT/usr/bin/$c" ]; then b=$c; break; fi
    if have "$c"; then b=$c; break; fi
  done
  d=$APPS/bin
  mkdir -p "$d" /usr/local/bin 2>/dev/null
  if [ -n "$b" ]; then
    cat > "$d/$name" <<TXT
#!/bin/sh
# pk-ios web launcher: $url  (browser: $b)
URL=\${1:-$url}
pk-run --gui $b --kiosk "\$URL" >/dev/null 2>&1 && exit 0
exec pk-run --gui $b "\$URL"
TXT
  else
    cat > "$d/$name" <<TXT
#!/bin/sh
# pk-ios web launcher: $url  (browser abhi nahi hai)
echo "$name: no browser found.  Install:  pk-get install -y firefox-esr" >&2
echo "  GUI ke liye pehle:  pk-x start      phir:  pk-run $name" >&2
exit 73
TXT
  fi
  chmod 755 "$d/$name" 2>/dev/null
  ln -sf "$d/$name" "/usr/local/bin/$name" 2>/dev/null
  cat > "$d/$name.desktop" <<TXT
[Desktop Entry]
Type=Application
Name=$name (web)
Exec=$name
Comment=pk-ios web wrapper for $url
TXT
  say "launcher bana: $d/$name   (chalane ke liye:  pk-run $name   ya   pk-run --gui $name)"
  [ -n "$b" ] || warn "no browser installed yet (pk-get install -y firefox-esr)"
  mark "IOS-WEB-OK ($name -> $url)"
  return 0
}

do_doctor() {
  printf 'pk-ios doctor\n'
  printf '  runtime (/opt/pk) : '
  if runtime_ok; then printf 'attached (%s)\n' "$(cat "$RT/etc/pk-runtime-release" 2>/dev/null | head -1 | cut -c1-50)"; else printf 'nahi laga\n'; fi
  printf '  unzip             : '; have unzip && printf 'haan\n' || printf 'NAHI (.ipa kholne ke liye chahiye)\n'
  printf '  browser (web wrap): '; for c in firefox-esr firefox epiphany chromium surf; do if runtime_ok && [ -x "$RT/usr/bin/$c" ]; then printf '%s (runtime)\n' "$c"; break; fi; if have "$c"; then printf '%s (base)\n' "$c"; break; fi; printf 'koi nahi -> pk-get install -y firefox-esr\n'; break; done
  printf '  qemu (mac guest)  : '; if [ -x "$RT/usr/bin/qemu-system-x86_64" ] || have qemu-system-x86_64; then printf 'haan\n'; else printf 'nahi -> pk-get install -y qemu-system-x86\n'; fi
  printf '  /dev/kvm          : '; [ -e /dev/kvm ] && printf 'haan (tezos)\n' || printf 'nahi (TCG se 5-10x dheema)\n'
  printf '  darling           : '; if runtime_ok && { [ -x "$RT/usr/bin/darling" ] || [ -x "$RT/usr/bin/darling-shell" ]; }; then printf 'installed\n'; else printf 'nahi (macOS binaries ke liye; pk-ios darling)\n'; fi
  printf '\n  yaad: iOS/.ipa kabhi native nahi chalega; upar wale raaste hi real hain.\n'
  mark "IOS-DOCTOR-OK"
}

do_mac_guest() {
  out=${HOME}/pk-ios-mac.sh
  cat > "$out" <<'TXT'
#!/bin/sh
# pk's OS :: macOS guest + Xcode iOS Simulator ka setup (jo actually chalta hai)
# Ye script QEMU guest banati hai; macOS image aapko khud chahiye (Apple license:
# macOS sirf Apple hardware par; hackintosh/virtualization apke risk par -
# padh lo: https://apple.com/legal/macos-license ). Setup ke liye sabse
# maintain kiya gaya recipe: github.com/kholia/OSX-KVM (boot-macOS.py / OpenCore).
set -eu
IMG=${1:-}
NAME=macos
if ! command -v pk-vm >/dev/null 2>&1; then
  echo "pk-vm not found (inside the runtime:  pk-get install -y qemu-system-x86 ovmf)" >&2
  exit 70
fi
pk-vm new "$NAME" --size=80G
echo
echo "ab image attach karke install karo:"
echo "  pk-vm run $NAME --cdrom=<macOS.iso> --ram=8192 --cpus=4 --uefi --vnc=:1"
echo "  (guest me: Xcode install -> Xcode > Settings > Platforms -> iOS Simulator)"
echo "  then drag the .ipa into the simulator - that is the only real iOS app runtime"
echo
if [ -n "$IMG" ]; then
  echo "ISO: $IMG"
  pk-vm run "$NAME" --cdrom="$IMG" --ram=8192 --cpus=4 --uefi --vnc=:1
else
  echo "no ISO was given; run the command above yourself."
fi
TXT
  chmod 755 "$out"
  say "wrote the guest script: $out"
  say "to run it:  sh $out [macOS.iso]   (needs qemu + ovmf in the runtime)"
  [ "${1:-}" = "--run" ] && sh "$out" ${2:-}
  return 0
}

do_darling() {
  cat <<'TXT'
Darling (https://darling.software) macOS userspace ka Linux translator hai:
  - kya chalta hai : macOS ka *x86_64/arm64 Mach-O console/GUI* code (Cocoa subset)
  - kya NAHI chalta: iOS apps (.ipa) - UIKit/CoreAnimation/etc Darling me nahi hain
  - Linux kernel modules chahiye (darwin.ko / dyld shared cache) -> real PC par
    kernel headers + build; yahan (VM/sandbox) test nahi kiya gaya hai
Setup (aapke PC par, ~15-30 min):
  sudo apt-get install -y git cmake build-essential libcap-dev zlib1g-dev \
    libicu-dev libxml2-dev libssl-dev libsdl2-dev libvulkan-dev pkg-config \
    uuid-dev libevent-dev libunwind-dev
  git clone --recursive https://github.com/darlinghq/darling.git
  cd darling && mkdir build && cd build && cmake .. && make -j2
  ./darling shell            # ek macOS-like shell; wahan ./hello.chalega
TXT
  if [ "${1:-}" = "--setup" ]; then
    say "--setup: installing the dependencies inside the runtime (needs network)"
    if pk-get install -y git cmake build-essential libcap-dev zlib1g-dev libicu-dev \
        libxml2-dev libssl-dev libsdl2-dev libvulkan-dev pkg-config uuid-dev \
        libevent-dev libunwind-dev 2>&1 | tail -3; then
      say "ab:  pk-shell  ke andar  git clone --recursive https://github.com/darlinghq/darling.git && make"
      mark "IOS-DARLING-DEPS-OK"
    else
      warn "pk-get fail (runtime attach hai? net hai?)"
      mark "IOS-DARLING-DEPS-FAIL"
      return 70
    fi
  fi
  return 0
}

case "${1:-}" in
  doctor)   shift; do_doctor ;;
  why|why-not|why-) why ;;
  info)     shift; do_info "${1:?file.ipa do}" ;;
  extract)  shift; do_extract "${1:?file.ipa do}" "${2:-}" ;;
  web)      shift; do_web "${1:?url do}" "${2:-}" "${3:-}" ;;
  mac-guest|guest) shift; [ "${1:-}" = --run ] && do_mac_guest --run "${2:-}" || do_mac_guest ;;
  darling)  shift; do_darling "${1:-}" ;;
  ""|--help|-h) sed -n '2,14p' "$0"; echo; why ;;
  *) warn "unknown: $1  (pk-ios --help)"; exit 1 ;;
esac
