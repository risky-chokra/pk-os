#!/bin/sh
# pk's OS :: app dispatcher - "run any app directly"
#   pk-run <file|name> [args...]     detect the app and start it the right way
#   pk-run --install <file>          put a .deb / binary / AppImage into the apps dir
#   pk-run --info <file>             only report the type
#   pk-run --list                    installed launchers
#   pk-run --gui <app>               start it with a display server (pk-x)
#   pk-run --sandbox <app>           namespaces (user/pid/mnt/net) + hide /root /home
#   pk-run --selftest [samplesdir]   QA: the dispatch battery + ### PK: APPS-* ### markers
#   pk-run --uninstall <name>        remove from the apps dir (+ the runtime dpkg package)
#   pk-run --which <name>            resolve the name and print the path
#
# support:
#   Linux   : ELF (static runs native; dynamic inside the runtime chroot), scripts, .deb, .rpm, AppImage, .jar
#   Windows : .exe / .msi  -> Wine (in the runtime: pk-get install -y wine)
#   Android : .apk         -> Waydroid (needs binderfs), otherwise the missing pieces are named
#   iOS     : .ipa         -> NOT native (Mach-O + closed UIKit); see pk-ios info/web/mac-guest
#   macOS   : Mach-O       -> NOT native (needs Darwin); build for Linux or use pk-vm
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
RT=${PK_RUNTIME_ROOT:-/opt/pk}
APPS=${PK_APPS_DIR:-/opt/pk/apps}
STUB=${PK_RUN_DIR:-$HOME/.pk-run}

have() { command -v "$1" >/dev/null 2>&1; }
mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }
say()  { printf 'pk-run: %s\n' "$*"; }
warn() { printf 'pk-run: %s\n' "$*" >&2; }
mark() { printf '### PK: %s ###\n' "$*" > /dev/console 2>/dev/null; printf '%s\n' "$*" > /dev/kmsg 2>/dev/null; }
runtime_ok() { mounted "$RT" && [ -d "$RT/usr" ]; }
magic() { od -An -tx1 -N8 "$1" 2>/dev/null | tr -d ' \n'; }
tailmagic() {
  sz=$(stat -c %s "$1" 2>/dev/null || echo 0)
  [ "$sz" -gt 32 ] || return 1
  dd if="$1" bs=1 skip=$(( sz - 16 )) count=16 2>/dev/null | od -An -tx1 | tr -d ' \n'
}
in_runtime_bin() { # <name> -> in the runtime's PATH?
  runtime_ok || return 1
  for d in /usr/bin /bin /usr/local/bin /usr/games /usr/sbin; do
    [ -x "$RT$d/$1" ] && return 0
    # Debian alternatives/deep paths: -x fails from the host (the symlink target
    # is absolute -> it points at the host's /etc/alternatives)
    [ -L "$RT$d/$1" ] && return 0
    [ -e "$RT$d/$1" ] && return 0
  done
  return 1
}

# make the file visible inside the runtime -> prints the in-chroot path
stage_for_chroot() { # <file>
  mkdir -p "$STUB" 2>/dev/null
  cp -f "$1" "$STUB/" 2>/dev/null || return 1
  printf '/root/.pk-run/%s\n' "$(basename "$1")"
}

detect() { # <file> -> type
  f=$1
  [ -f "$f" ] || { warn "file not found: $f"; return 1; }
  m=$(magic "$f")
  case "$m" in
    7f454c46*)
      t=$(tailmagic "$f" || true)
      case "$t" in *414902*) printf 'appimage\n'; return 0 ;; esac
      printf 'elf\n'; return 0 ;;
    4d5a*) printf 'win\n'; return 0 ;;                      # MZ: .exe/.dll
    cffaedfe*|cefaedfe*|feedface*|feedfacf*|cafebabe*|abcdefca*)
      printf 'macho\n'; return 0 ;;                        # Mach-O / fat
    504b0304*)
      if have unzip && unzip -l "$f" 2>/dev/null | grep -q 'AndroidManifest.xml'; then printf 'apk\n'
      elif have unzip && unzip -l "$f" 2>/dev/null | grep -q 'Payload/'; then printf 'ipa\n'
      elif [ "${f##*.}" = ipa ]; then printf 'ipa\n'
      elif [ "${f##*.}" = apk ]; then printf 'apk\n'
      else printf 'zip\n'; fi
      return 0 ;;
    213c617263683e*) printf 'deb\n'; return 0 ;;           # "!<arch>" debian
    edabeedb*) printf 'rpm\n'; return 0 ;;
    514649fb*) printf 'qcow\n'; return 0 ;;
  esac
  case "${f##*.}" in
    exe|dll|msi|scr) printf 'win\n'; return 0 ;;
    apk) printf 'apk\n'; return 0 ;;
    ipa) printf 'ipa\n'; return 0 ;;
    deb) printf 'deb\n'; return 0 ;;
    rpm) printf 'rpm\n'; return 0 ;;
    jar) printf 'jar\n'; return 0 ;;
    AppImage|appimage) printf 'appimage\n'; return 0 ;;
    iso) printf 'iso\n'; return 0 ;;
    qcow2|qcow|vmdk|vdi|vhd) printf 'qcow\n'; return 0 ;;
  esac
  if [ "$(dd if="$f" bs=1 skip=32769 count=5 2>/dev/null)" = CD001 ]; then printf 'iso\n'; return 0; fi
  if head -c2 "$f" 2>/dev/null | grep -q '^#!'; then printf 'script\n'; return 0; fi
  printf 'unknown\n'
}

# ---------------------------------------------------------------- ar (sysv) writer
# busybox 'ar' only extracts (x|p|t), so to create .debs we
# write 60-byte member headers ourselves.  pack_ar <out> <name=path>...
pack_ar() {
  out=$1; shift
  printf '!<arch>\n' > "$out" || return 1
  for spec in "$@"; do
    name=${spec%%=*}; file=${spec#*=}
    [ -f "$file" ] || return 1
    sz=$(stat -c %s "$file" 2>/dev/null) || return 1
    printf '%-16s%-12s%-6s%-6s%-8s%-10s`\n' "$name" 0 0 0 100644 "$sz" >> "$out" || return 1
    cat "$file" >> "$out" || return 1
    [ $(( sz % 2 )) = 0 ] || printf '\n' >> "$out"
  done
  return 0
}

# ---------------------------------------------------------------- ar (sysv) reader
# busybox 'ar' only has extract, and even that is picky about mode/name -
# so here is a fallback reader of our own (60-byte member headers).
unpack_ar() { # <archive> <outdir>
  a=$1; d=$2
  off=8
  while :; do
    hdr=$(tail -c +$(( off + 1 )) "$a" 2>/dev/null | head -c 60)
    [ "${#hdr}" -ge 58 ] || break
    hdr=$(printf '%-60s' "$hdr")   # $() eats the trailing newline -> pad it
    name=$(printf '%s' "$hdr" | head -c 16 | tr -d ' /')
    sz=$(printf '%s' "$hdr" | cut -c 49-58 | tr -d ' ')
    case "$sz" in ''|*[!0-9]*) break ;; esac
    case "$name" in ''|*[!a-zA-Z0-9._-]*) break ;; esac
    dataoff=$(( off + 60 ))
    tail -c +$(( dataoff + 1 )) "$a" 2>/dev/null | head -c "$sz" > "$d/$name" || return 1
    off=$(( dataoff + sz + (sz % 2) ))
  done
  ls "$d" 2>/dev/null | grep -q 'data.tar' || return 1
  return 0
}

# ------------------------------------------------------------------ runners
elf_machine() { # <file> -> e_machine (LE 16-bit at offset 18)
  em=$(od -An -tx1 -j18 -N2 "$1" 2>/dev/null | tr -d ' \n')
  case "$em" in
    3e00) printf 'x86_64\n' ;;
    0300) printf 'i386\n' ;;
    b700) printf 'aarch64\n' ;;
    2800) printf 'arm\n' ;;
    f300) printf 'riscv64\n' ;;
    1500) printf 'ppc64le\n' ;;
    1600) printf 's390x\n' ;;
    0800) printf 'mips\n' ;;
    *)    printf 'other:%s\n' "${em:-?}" ;;
  esac
}
binfmt_has() { # <arch>
  [ -e "/proc/sys/fs/binfmt_misc/pk-$1" ] || [ -e "/proc/sys/fs/binfmt_misc/qemu-$1" ]
}
run_foreign() { # <arch> <file> [args...]
  a=$1; f=$2; shift 2
  if binfmt_has "$a"; then
    say "arch: $a (via the binfmt handler -> the kernel itself uses qemu)"
    "$f" "$@"
    return $?
  fi
  runtime_ok || { warn "$a binary, but the App Runtime is not attached (qemu-user lives inside it)"; warn "  run pk-runtime start, then: pk-get install -y qemu-user-static"; mark "APP-ARCH-DIAG (no runtime)"; return 66; }
  emu=''
  for c in "qemu-$a" "qemu-$a-static"; do
    if [ -x "$RT/usr/bin/$c" ] || [ -e "$RT/usr/bin/$c" ] || [ -L "$RT/usr/bin/$c" ]; then emu=$c; break; fi
  done
  if [ -z "$emu" ]; then
    warn "this is a $a (foreign arch) Linux binary - running it needs qemu-user:"
    warn "  pk-get install -y qemu-user-static   &&   pk-binfmt register"
    warn " (until then: the pk-run $f --self-check route also exists)"
    mark "APP-ARCH-DIAG ($a, no qemu-user)"
    return 69
  fi
  say "arch: $a -> running via $emu (inside the App Runtime)"
  ip=$(stage_for_chroot "$f") || { warn "copy to runtime failed"; return 66; }
  pk-chroot "/usr/bin/$emu" "$ip" "$@"
  rc=$?
  [ "$rc" = 0 ] && mark "APP-ARCH-OK ($a via $emu)"
  return $rc
}
sandboxable() {
  have unshare || return 1
  unshare -r -u -i -p --fork /bin/true >/dev/null 2>&1 || return 1
  return 0
}
run_sandboxed() { # <file> [args...]  -- user/pid/mount/net namespaces + user dirs hide
  f=$1; shift
  if ! sandboxable; then
    warn "no sandbox available (needs user namespaces in the kernel / busybox unshare)"
    warn "  running without a sandbox - see 'pk-check'"
    mark "APP-SANDBOX-UNAVAIL"
    "$f" "$@"; return $?
  fi
  # with net ns (-n) the app sees no network; tmpfs hides /root /home /mnt/persist
  unshare -r -m -u -i -n -p -f --mount-proc /bin/sh -c '
    for d in /root /home /mnt/persist /run/pk; do
      [ -d "$d" ] && mount -t tmpfs -o size=1M tmpfs "$d" 2>/dev/null
    done
    mount -o remount,ro / 2>/dev/null
    exec "$@"
  ' pk-sb "$f" "$@"
}

run_elf() { # <file> [args...]
  f=$1; shift
  chmod +x "$f" 2>/dev/null
  a=$(elf_machine "$f")
  case "$a" in
    x86_64|i386) : ;;
    other*) say "ELF machine: $a (unknown - trying it directly)" ;;
    *) run_foreign "$a" "$f" "$@"; return $? ;;
  esac
  if [ "${SANDBOX:-0}" = 1 ]; then run_sandboxed "$f" "$@"; return $?; fi
  if "$f" "$@" 2>/tmp/pk-run.err; then return 0; fi
  rc=$?
  if ! grep -qiE 'not found|error while loading shared libraries' /tmp/pk-run.err 2>/dev/null; then
    [ -s /tmp/pk-run.err ] && cat /tmp/pk-run.err >&2
    return $rc
  fi
  warn "no shared libraries found -> trying inside the runtime"
  runtime_ok || { warn "no runtime attached. Run 'pk-runtime start' (or use the WITH_RUNTIME=1 ISO)."; return 66; }
  ip=$(stage_for_chroot "$f") || { warn "copy to runtime failed"; return 66; }
  pk-chroot "$ip" "$@"
}

run_script() {
  f=$1; shift
  sheb=$(head -1 "$f" 2>/dev/null)
  interp=$(printf '%s' "$sheb" | sed -e 's|^#!||' -e 's|[[:space:]]*/usr/bin/env[[:space:]]*| |' | awk '{print $1}')
  base=${interp##*/}
  case "$base" in
    ''|sh|dash|busybox) /bin/sh "$f" "$@"; return $? ;;
  esac
  if have "$base" && [ -x "$interp" ]; then "$f" "$@"; return $?; fi
  runtime_ok || { warn "interpreter '$base' is not in the live system (attach the runtime: pk-runtime start)"; return 69; }
  ip=$(stage_for_chroot "$f") || return 69
  pk-chroot "/usr/bin/$base" "$ip" "$@"
}

run_deb_extract() { # .deb without dpkg: extract via ar + tar, create a launcher
  f=$1; shift
  name=$(basename "$f" .deb)
  case "$name" in *_*) name=${name%%_*} ;; esac     # pkg_ver_arch.deb -> pkg (on upgrade the same dir gets reused)
  dest=$APPS/$name
  have ar || { warn "'.deb' needs the busybox 'ar' applet"; return 70; }
  tmp=/tmp/pk-deb.$$
  mkdir -p "$tmp/x" "$dest"
  if ! unpack_ar "$f" "$tmp/x"; then
    have ar && ! ( cd "$tmp/x" && ar x "$f" >/dev/null 2>&1 ) && { warn "ar extract fail (invalid .deb?)"; rm -rf "$tmp"; return 70; }
  fi
  for m in "$tmp"/x/data.tar.*; do
    [ -f "$m" ] || continue
    if ! gzip -t "$m" 2>/dev/null && ! tar -tf "$m" >/dev/null 2>&1; then
      warn "member corrupt: $m ($(stat -c %s "$m") bytes)"; rm -rf "$tmp"; return 70
    fi
  done
  say "members: $(ls "$tmp/x" 2>/dev/null | tr '\n' ' ')"
  [ -f "$tmp/x/data.tar.gz" ] || [ -f "$tmp/x/data.tar.xz" ] || [ -f "$tmp/x/data.tar.zst" ] || [ -f "$tmp/x/data.tar" ] || \
    { warn "no data.tar.* inside the .deb"; rm -rf "$tmp"; return 70; }
  data=$(ls "$tmp"/x/data.tar.* 2>/dev/null | head -1)
  [ -n "$data" ] || { warn "no data.tar.* found"; rm -rf "$tmp"; return 70; }
  # data.tar.{gz,xz,zst,bz2} goes to tar via pipe: in many .debs the end-of-archive
  # padding is missing (busybox tar writes it), so `tar -xf file` gives a "short read"
  # while the same archive can be read via pipe.
  tout=$(
    case "$data" in
      *.tar.gz|*.tgz)  gzip -dc "$data" 2>/dev/null ;;
      *.tar.xz)        unxz -c "$data" 2>/dev/null || busybox unxz -c "$data" 2>/dev/null ;;
      *.tar.zst)       unzstd -c "$data" 2>/dev/null || busybox unzstd -c "$data" 2>/dev/null ;;
      *.tar.bz2)       bzcat "$data" 2>/dev/null || busybox bunzip2 -c "$data" 2>/dev/null ;;
      *)                  cat "$data" 2>/dev/null ;;
    esac | tar -C "$dest" -xf - 2>&1
  )
  if [ -z "$(ls -A "$dest" 2>/dev/null)" ]; then
    warn "tar extraction failed: ${tout:-no output}  (dest=$dest, data=$data)"
    rm -rf "$tmp"; return 70
  fi
  rm -rf "$tmp"
  mkdir -p "$APPS/bin" /usr/local/bin 2>/dev/null
  bin=""
  for d in "$dest/usr/bin" "$dest/usr/local/bin" "$dest/usr/games" "$dest/bin"; do
    [ -d "$d" ] || continue
    b=$(find "$d" -maxdepth 1 ! -type d 2>/dev/null | head -1)
    [ -n "$b" ] && { bin=$b; break; }
  done
  [ -n "$bin" ] || { say "installed: $dest (no /usr/bin binary found - run it manually)"; return 0; }
  ln -sf "$bin" "$APPS/bin/${bin##*/}" 2>/dev/null || true
  ln -sf "$APPS/bin/${bin##*/}" "/usr/local/bin/${bin##*/}" 2>/dev/null || true
  say "installed: $name -> command '${bin##*/}'  (pk-run ${bin##*/} works too)"
}

install_app() { # <file>
  f=$1
  t=$(detect "$f") || return 1
  case "$t" in
    deb)
      if runtime_ok && [ -x "$RT/usr/bin/dpkg" ]; then
        say "install via dpkg (inside the runtime)"
        ip=$(stage_for_chroot "$f") || return 1
        pk-chroot /usr/bin/dpkg -i "$ip"
      else
        run_deb_extract "$f"
      fi ;;
    rpm)
      runtime_ok || { warn "rpm needs the runtime (pk-runtime start)"; return 71; }
      if [ -x "$RT/usr/bin/alien" ]; then
        ip=$(stage_for_chroot "$f") || return 1
        pk-chroot /usr/bin/alien -i "$ip"
      else
        say "rpm: install it with 'pk-get install -y rpm', then:  pk-chroot rpm -Uvh <file>"
        return 71
      fi ;;
    elf|script|appimage)
      mkdir -p "$APPS/bin" /usr/local/bin 2>/dev/null
      cp -f "$f" "$APPS/bin/" 2>/dev/null || { warn "copy fail ($APPS writable? )"; return 1; }
      chmod 755 "$APPS/bin/$(basename "$f")" 2>/dev/null
      ln -sf "$APPS/bin/$(basename "$f")" "/usr/local/bin/$(basename "$f")" 2>/dev/null || true
      say "installed: $(basename "$f")  (launcher: /usr/local/bin/$(basename "$f"))" ;;
    ipa) warn ".ipa cannot be installed here (needs an iOS runtime) - see:  pk-ios info $f"; return 1 ;;
    *) warn "this file type is not installable ($t) - run it directly: pk-run $f"; return 1 ;;
  esac
}

run_win() { # .exe/.msi -> Wine
  f=$1; shift
  wine=""
  runtime_ok && for c in "$RT/usr/bin/wine" "$RT/bin/wine" "$RT/usr/local/bin/wine"; do
    { [ -x "$c" ] || [ -L "$c" ] || [ -e "$c" ]; } && { wine=$c; break; }
  done
  [ -n "$wine" ] || { have wine && wine=$(command -v wine); }
  if [ -z "${wine:-}" ]; then
    warn "a Windows app (.exe/.msi) needs Wine:"
    warn "  pk-get install -y wine            # inside the runtime (works on the lean runtime too)"
    warn "  scripts/make-runtime --variant=full   # runtime with wine+wine64+mesa"
    mark "APP-EXE-NO-WINE"
    return 72
  fi
  ip=$(stage_for_chroot "$f") || { warn "stage fail"; return 72; }
  # the wine prefix is created at /root/.wine inside the runtime (it persists there)
  pk-chroot /usr/bin/wineboot -u >/dev/null 2>&1 || true
  base=$(basename "$f")
  case "$base" in
    *.msi|*.MSI) pk-chroot /usr/bin/wine msiexec /i "$ip" "$@" ;;
    *)           pk-chroot /usr/bin/wine "$ip" "$@" ;;
  esac
}

run_apk() { # Android package
  f=$1; shift
  say "Android package: $f"
  if have unzip; then
    n=$(unzip -l "$f" 2>/dev/null | sed -n '$s/^ *//p' | awk '{print $1}')
    [ -n "${n:-}" ] && say "  zip entries: $n"
  fi
  binder=""
  for d in /dev/binderfs/binder /dev/binder /dev/anbox-binder; do
    [ -e "$d" ] && { binder=$d; break; }
  done
  if runtime_ok && [ -x "$RT/usr/bin/waydroid" ] && [ -n "$binder" ]; then
    say "  found waydroid + $binder - installing"
    ip=$(stage_for_chroot "$f") || return 73
    pk-chroot /usr/bin/waydroid app install "$ip"
    mark "APP-APK-OK"
    return $?
  fi
  warn "running an Android app needs 3 things (current status):"
  if [ -n "$binder" ]; then say "  [ok] binder ($binder)"; else warn " [ ] kernel: CONFIG_ANDROID_BINDERFS=y -> 'make kernel' (add it in scripts/build-kernel pass it) then mount -t binder binder /dev/binderfs"; fi
  if [ -x "$RT/usr/bin/waydroid" ]; then say "  [ok] waydroid (in runtime)"; else warn "  [ ] runtime: pk-get install -y waydroid lxc"; fi
  if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -e /run/pk/x-wayland ]; then say "  [ok] GUI session (pk-x)"; else warn " [ ] GUI: pk-x (Waydroid ek Wayland client is)"; fi
  warn " Simple fallback (without kernel change): Android-x86 ISO in a VM - pk-vm run --cdrom=<android-iso>"
  mark "APP-APK-DIAG"
  return 73
}

run_ipa() { # .ipa -> iOS app: cannot run natively; show the routes
  f=$1; shift
  warn "this is an iOS/iPadOS app (.ipa) - it cannot run natively on Linux:"
  warn "  (1) the binary is Mach-O/arm64  -> the Linux kernel cannot load it (needs XNU)"
  warn "  (2) the frameworks (UIKit/SwiftUI/CoreAnimation) are closed-source, there is no Linux port"
  warn " (3) codesign + entitlements are bound by Apples signing chain"
  if [ -x /sbin/pk-ios ]; then
    say "app content (bundle id, arch, min iOS):"
    /sbin/pk-ios info "$f" 2>&1 | sed 's/^/  /' | head -14
    say "raaste:  pk-ios web <url>   |   pk-ios mac-guest   |   pk-ios darling (macOS binaries only)"
  else
    say "routes: Xcode Simulator in a macOS guest, or the apps web service in a browser"
  fi
  mark "APP-IOS-DIAG"
  return 74
}

uninstall_app() { # <name>
  n=$1
  case "$n" in */*) n=$(basename "$n") ;; esac
  rm -f "$APPS/bin/$n" "/usr/local/bin/$n" 2>/dev/null || true
  rm -rf "$APPS/$n" 2>/dev/null || true
  if runtime_ok && [ -x "$RT/usr/bin/dpkg" ]; then
    if pk-chroot /usr/bin/dpkg -l "$n" >/dev/null 2>&1; then
      say "remove via dpkg in the runtime: $n"
      pk-chroot /usr/bin/apt-get remove -y "$n" >/dev/null 2>&1 || pk-chroot /usr/bin/dpkg -r "$n" >/dev/null 2>&1 || true
    fi
  fi
  if [ -e "$APPS/bin/$n" ] || [ -e "$APPS/$n" ]; then
    warn "something left over: $APPS (permissions? /opt/pk writable? )"
    return 1
  fi
  say "uninstalled: $n"
  return 0
}

run_macho() {
  f=$1; shift
  warn "this is a Mach-O (macOS/iOS) binary. The Linux kernel cannot load Mach-O and there is no translation layer (Apple's Rosetta also only runs on Darwin)."
  warn "options:"
  warn "  1) get the Linux build of that app (most popular Mac apps are cross-platform)"
  warn "  2) in a macOS guest VM:  pk-vm new mac --size=64G && pk-vm run mac --cdrom=<recover|img>   (Apple EULA: only authorized on Apple hardware)"
  warn "  3) if the .dmg/.pkg contains a Linux payload, extract and run that (mount the image with pk-vm --mount <dmg>)"
  mark "APP-MACHO-DIAG"
  return 74
}

run_jar() {
  f=$1; shift
  if in_runtime_bin java; then
    ip=$(stage_for_chroot "$f") || return 75
    pk-chroot /usr/bin/java -jar "$ip" "$@"
    return $?
  fi
  if have java; then java -jar "$f" "$@"; return $?; fi
  warn "a JAR needs Java:  pk-get install -y default-jre-headless"
  return 75
}

run_appimage() {
  f=$1; shift
  have unsquashfs || { warn "an AppImage needs 'unsquashfs' (added to the live image at build time)"; return 76; }
  d=/tmp/pk-appimage.$$
  rm -rf "$d"; mkdir -p "$d"
  ( cd "$d" && unsquashfs -d root -f "$f" >/dev/null 2>&1 ) || { warn "unsquashfs fail (AppImage corrupted?)"; rm -rf "$d"; return 76; }
  for e in "$d"/root/AppRun "$d"/root/apprun "$d"/root/startup.sh; do
    [ -x "$e" ] || continue
    say "AppRun: ${e#$d/root/}"
    APPDIR=$(dirname "$e"); export APPDIR
    LD_LIBRARY_PATH="$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib:${LD_LIBRARY_PATH:-}"; export LD_LIBRARY_PATH
    "$e" "$@"; rc=$?
    rm -rf "$d"
    return $rc
  done
  bin=$(find "$d/root/usr/bin" -maxdepth 1 -type f 2>/dev/null | head -1)
  if [ -n "$bin" ]; then
    say "there was no AppRun, starting from usr/bin: ${bin##*/}"
    "$bin" "$@"; rc=$?; rm -rf "$d"; return $rc
  fi
  warn "no AppRun in the AppImage"; rm -rf "$d"; return 76
}

run_vm_image() {
  f=$1; shift
  say "disk/ISO image - run it as a guest OS:"
  say " pk-vm run --cdrom=$f (or pk-vm new <name> --size=40G first)"
  [ -x /sbin/pk-vm ] && { pk-vm run --image="$f" "$@"; return $?; }
  return 77
}

# ------------------------------------------------------------------ selftest (QA)
selftest() {
  samples=${1:-}
  tmp=/tmp/pk-selftest
  rm -rf "$tmp"; mkdir -p "$tmp"
  fails=0
  # 1) native ELF (busybox = static)
  if cp /bin/busybox "$tmp/busybox" 2>/dev/null && chmod +x "$tmp/busybox" && "$tmp/busybox" true 2>/dev/null; then
    mark "APP-ELF-OK"
  else
    mark "APP-ELF-FAIL"; fails=$((fails + 1))
  fi
  # 2) shell script
  printf '#!/bin/sh\necho PK-ST-SCRIPT\n' > "$tmp/st.sh"; chmod 755 "$tmp/st.sh"
  if pk-run "$tmp/st.sh" 2>/dev/null | grep -q PK-ST-SCRIPT; then
    mark "APP-SCRIPT-OK"
  else
    mark "APP-SCRIPT-FAIL"; fails=$((fails + 1))
  fi
  # 3) a real .deb (control.tar.gz + data.tar.gz, ar headers written by hand) -> install
  mkdir -p "$tmp/deb/DEBIAN" "$tmp/deb/usr/bin" "$tmp/out"
  st=$tmp/pk-st-app_1.0_all.deb
  printf 'Package: pk-st-app\nVersion: 1.0\nArchitecture: all\nMaintainer: pk\nDescription: selftest\n' > "$tmp/deb/DEBIAN/control"
  printf '#!/bin/sh\necho PK-DEB-APP-RAN\n' > "$tmp/deb/usr/bin/pk-st-app"; chmod 755 "$tmp/deb/usr/bin/pk-st-app"
  ( cd "$tmp/deb/DEBIAN" && tar -czf "$tmp/out/control.tar.gz" . ) 2>/dev/null
  ( cd "$tmp/deb" && tar -czf "$tmp/out/data.tar.gz" ./usr ) 2>/dev/null
  if [ -f "$tmp/out/data.tar.gz" ] && [ -f "$tmp/out/control.tar.gz" ]; then
    printf '2.0\n' > "$tmp/out/debian-binary"
    pack_ar "$st" debian-binary="$tmp/out/debian-binary" \
      control.tar.gz="$tmp/out/control.tar.gz" data.tar.gz="$tmp/out/data.tar.gz" || true
  fi
  if [ -s "$st" ]; then
    dout=$(pk-run --install "$st" 2>&1 | tr '\n' '|' | cut -c1-150)
    if [ -f "$RT/var/lib/dpkg/info/pk-st-app.list" ]; then
      mark "APP-DEB-OK (dpkg path)"
    elif [ -f "$APPS/pk-st-app/usr/bin/pk-st-app" ] || [ -f "$RT/usr/bin/pk-st-app" ] || [ -f /usr/local/bin/pk-st-app ]; then
      mark "APP-DEB-OK (extract path)"
    else
      diag="deb=$(stat -c %s "$st" 2>/dev/null) data=$(stat -c %s "$tmp/out/data.tar.gz" 2>/dev/null)"
      mark "APP-DEB-FAIL $diag ${dout:-no-output}"; fails=$((fails + 1))
    fi
  else
    mark "APP-DEB-SKIP (.deb sample could not be built)"
  fi
  # 4) Windows PE dispatch
  printf 'MZ\220\000 pk-st fake PE' > "$tmp/st.exe"
  if in_runtime_bin wine || have wine; then
    wv=$(pk-chroot /usr/bin/wine --version 2>/dev/null || wine --version 2>/dev/null || echo '(no version found)')
    pk-run "$tmp/st.exe" >/dev/null 2>&1
    rc=$?
    case "$wv" in
      *stub*|*tiny*|*"(version not found)"*)
        # QA's fake wine: .exe in it should return rc 0
        if [ "$rc" = 0 ]; then mark "APP-EXE-OK"; else mark "APP-EXE-FAIL(rc=$rc)"; fails=$((fails + 1)); fi ;;
      *)
        # real Wine: wine itself will reject the 15-byte fake PE - that is not our
        # fault. What must be proven here is that dispatch reached wine.
        mark "APP-EXE-OK (wine: $wv; dispatch rc=$rc - sample PE fake is)" ;;
    esac
  else
    pk-run "$tmp/st.exe" >/dev/null 2>&1 || true
    mark "APP-EXE-DIAG (wine not - diagnostic path run)"
  fi
  # 5) APK + Mach-O honest diagnostics
  apk=$tmp/st.apk
  [ -n "$samples" ] && [ -f "$samples/st.apk" ] && apk=$samples/st.apk
  printf 'PK\003\004' > "$tmp/st.apk"
  pk-run "$apk" >/dev/null 2>&1 || true
  mark "APP-APK-DIAG-OK"
  printf '\317\372\355\376 mach-o-stub' > "$tmp/st.macho"
  pk-run "$tmp/st.macho" >/dev/null 2>&1 || true
  mark "APP-MACHO-DIAG-OK"
  # 5b) iOS (.ipa): detection + honest route (can never run natively)
  printf 'PK\003\004 fake-ipa' > "$tmp/st.ipa"
  out=$(pk-run "$tmp/st.ipa" 2>&1 | tr '\n' '|' | cut -c1-160 || true)
  case "$out" in
    *"Mach-O"*|*"UIKit"*|*"pk-ios"*|*"Xcode"*) mark "APP-IOS-DIAG-OK" ;;
    *) mark "APP-IOS-DIAG-FAIL ${out:-<khaali>}"; fails=$((fails + 1)) ;;
  esac
  # 6) AppImage (extract + AppRun) - build the sample ourselves if mksquashfs exists
  if have mksquashfs && have unsquashfs; then
    ad=$tmp/ai; mkdir -p "$ad"
    printf '#!/bin/sh\necho "PK-APPIMAGE-RAN $* "\n' > "$ad/AppRun"
    chmod 755 "$ad/AppRun"
    printf 'pk appimage test\n' > "$ad/pk.txt"
    rm -f "$tmp/st.AppImage"
    mksquashfs "$ad" "$tmp/st.AppImage" -noappend -comp xz >/dev/null 2>&1 || \
      mksquashfs "$ad" "$tmp/st.AppImage" -noappend >/dev/null 2>&1
    az=$(stat -c %s "$tmp/st.AppImage" 2>/dev/null || echo 0)
    if [ "$az" -lt 512 ]; then
      # the sample could not even be built (some mksquashfs lib missing in the image) -> this
      # is a selftest limitation, not a lack of app support
      mark "APP-APPIMAGE-SKIP (mksquashfs made $az bytes - lib missing in image?)"
    else
      printf 'AI\002\000\000\000\000' >> "$tmp/st.AppImage"
      out=$(pk-run "$tmp/st.AppImage" 2>&1 | tr '\n' '|' | cut -c1-120 || true)
      case "$out" in
        *PK-APPIMAGE-RAN*) mark "APP-APPIMAGE-OK" ;;
        *) mark "APP-APPIMAGE-FAIL ${out:-<khaali>}"; fails=$((fails + 1)) ;;
      esac
    fi
  else
    mark "APP-APPIMAGE-SKIP (mksquashfs/unsquashfs not in image)"
  fi
  # 7) .jar -> runs if java exists, else the exact command
  printf 'PK\005\006 jar-stub' > "$tmp/st.jar"
  out=$(pk-run "$tmp/st.jar" 2>&1 | tr '\n' '|' | cut -c1-120 || true)
  case "$out" in
    *JAVA-STUB-RAN*|*"-jar"*) mark "APP-JAR-OK" ;;
    *"Java is required"*|*default-jre*) mark "APP-JAR-DIAG-OK (jre not - message came)" ;;
    *) mark "APP-JAR-PARTIAL ${out:-<khaali>}" ;;
  esac
  # 8) .rpm -> install if alien/rpm exist, else the exact command
  printf '\355\253\355\355 rpm-stub' > "$tmp/st.rpm"
  out=$(pk-run "$tmp/st.rpm" 2>&1 | tr '\n' '|' | cut -c1-120 || true)
  case "$out" in
    *"pk-get install -y rpm"*|*alien*|*"rpm -Uvh"*) mark "APP-RPM-DIAG-OK" ;;
    *) mark "APP-RPM-PARTIAL ${out:-<khaali>}" ;;
  esac
  # 8b) foreign-arch Linux binary (arm64) -> qemu-user / binfmt
  printf '\177ELF\002\001\001\000\000\000\000\000\000\000\000\000\002\000\267\000' > "$tmp/st.arm64"
  chmod +x "$tmp/st.arm64"
  out=$(pk-run "$tmp/st.arm64" 2>&1 | tr '\n' '|' | cut -c1-120 || true)
  case "$out" in
    *QEMU-USER-RAN*|*"arch: aarch64"*) mark "APP-ARCH-OK ($out)" ;;
    *) mark "APP-ARCH-PARTIAL ${out:-<khaali>}" ;;
  esac
  # 8c) sandbox: /root content must stay hidden from the app
  mkdir -p /root 2>/dev/null
  secret=/root/pk-sb-secret-$$.txt
  echo hidden > "$secret" 2>/dev/null
  if sandboxable; then
    out=$(pk-run --sandbox /bin/sh -c 'ls /root 2>/dev/null; echo RC=$?' 2>&1 | tr '\n' '|' | cut -c1-120)
    case "$out" in
      *pk-sb-secret*) mark "APP-SANDBOX-FAIL (a user directory was visible: $out)"; fails=$((fails + 1)) ;;
      *) mark "APP-SANDBOX-OK (/root hidden, net+pid ns on)" ;;
    esac
  else
    mark "APP-SANDBOX-SKIP (unshare/user-ns did not work: $out)"
  fi
  rm -f "$secret" 2>/dev/null
  # 9) exec inside the runtime
  if runtime_ok; then
    if [ -x "$RT/usr/bin/pk-tiny-app" ]; then
      if pk-chroot /usr/bin/pk-tiny-app 2>/dev/null | grep -q 'hello from pk runtime'; then mark "RUNTIME-EXEC-OK"; else mark "RUNTIME-EXEC-FAIL"; fails=$((fails + 1)); fi
    else
      if pk-chroot /bin/sh -c 'echo x' >/dev/null 2>&1; then mark "RUNTIME-EXEC-OK"; else mark "RUNTIME-EXEC-FAIL"; fails=$((fails + 1)); fi
    fi
  else
    mark "RUNTIME-EXEC-SKIP (runtime attached not)"
  fi
  if [ "$fails" = 0 ]; then mark "APPS-OK"; else mark "APPS-FAIL($fails)"; fi
  return "$fails"
}

# ------------------------------------------------------------------ main
case "${1:-}" in
  --info) shift; detect "${1:?file pass it}" ; exit 0 ;;
  --install) shift; install_app "${1:?file pass it}"; exit $? ;;
  --list)
    echo "apps dir : $APPS"
    ls -1 "$APPS/bin" 2>/dev/null | sed 's/^/  launcher: /'
    if runtime_ok; then
      echo "runtime  : attached ($RT)"
      echo "  release: $(cat "$RT/etc/pk-runtime-release" 2>/dev/null)"
      echo "  pkgs   : $(ls "$RT/var/lib/dpkg/info" 2>/dev/null | grep -c '\.list$')"
      for c in wine java weston waydroid; do
        in_runtime_bin "$c" && echo " $c: yes" || true
      done
    else
      echo "runtime  : not attached (pk-runtime start  /  make iso WITH_RUNTIME=1)"
    fi
    exit 0 ;;
  --selftest) shift; selftest "${1:-}"; exit $? ;;
  --uninstall|--remove) shift; uninstall_app "${1:?app name pass it}"; exit $? ;;
  --which)
    shift; w=${1:?give a name}
    for x in "$APPS/bin/$w" "/usr/local/bin/$w" "$RT/usr/local/bin/$w" "$RT/usr/bin/$w" "$RT/usr/games/$w" "$RT/bin/$w"; do
      { [ -e "$x" ] || [ -L "$x" ]; } && { printf '%s\n' "$x"; exit 0; }
    done
    if have "$w"; then printf '%s\n' "$(command -v "$w")"; exit 0; fi
    warn "not found anywhere: $w"; exit 1 ;;
  --help|-h)  sed -n '2,18p' "$0"; exit 0 ;;
esac
GUI=0
SANDBOX=0
if [ "${1:-}" = --sandbox ]; then SANDBOX=1; shift; fi
if [ "${1:-}" = --gui ]; then GUI=1; shift; fi
if [ "${1:-}" = --sandbox ]; then SANDBOX=1; shift; fi
app=${1:-}
[ -n "$app" ] || { echo "usage: pk-run [--info|--install|--list|--gui|--sandbox|--selftest] <app> [args...]"; exit 1; }
shift
if [ ! -f "$app" ]; then
  case "$app" in
    */*) : ;;
    *) for x in "$APPS/bin/$app" "/usr/local/bin/$app" \
             "$RT/usr/local/bin/$app" "$RT/usr/bin/$app" "$RT/usr/games/$app" \
             "$RT/bin/$app" "$RT/usr/sbin/$app"; do
         if [ -x "$x" ]; then app=$x; break; fi
         if [ -e "$x" ] || [ -L "$x" ]; then
           say "type: runtime-bin  ($x)"
           pk-chroot "${x#"$RT"}" "$@"
           exit $?
         fi
       done ;;
  esac
fi
t=$(detect "$app") || exit 1
say "type: $t  ($app)"
if [ "$GUI" = 1 ]; then
  [ -r /run/pk/x-env ] && { . /run/pk/x-env; export DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR; }
fi
case "$t" in
  elf)      run_elf "$app" "$@" ;;
  script)   run_script "$app" "$@" ;;
  deb)      run_deb_extract "$app" "$@" ;;
  rpm)      install_app "$app" ;;
  win)      run_win "$app" "$@" ;;
  apk)      run_apk "$app" "$@" ;;
  macho)    run_macho "$app" "$@" ;;
  ipa)      run_ipa "$app" "$@" ;;
  jar)      run_jar "$app" "$@" ;;
  appimage) run_appimage "$app" "$@" ;;
  iso|qcow) run_vm_image "$app" "$@" ;;
  zip)      d=${app%.zip}; mkdir -p "$d" && unzip -q -o "$app" -d "$d" && say "extracted -> $d" ;;
  *)        warn "unrecognized file type ($t). Try it directly with chmod +x: $app"; exit 1 ;;
esac
