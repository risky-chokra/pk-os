#!/bin/sh
# pk's OS :: collect-bins <dest-root> <binary...>
#
# Copies binaries from the host + their library closure (ldd) + the dynamic loader into <dest-root>,
# preserving original absolute paths. So binaries also run in squashfs/initrd without package
# management.
#
# NOTE: we do not *recreate* symlinks (it would depend on merged-usr,
# leaving the /lib -> /usr/lib relative link dangling in the staged tree).
# Every referenced path gets a real file copy - some duplication, but guaranteed.
# shellcheck shell=sh disable=SC3030,SC2086,SC2046
set -eu

[ $# -ge 2 ] || { echo "usage: $0 <dest> <bin...>" >&2; exit 2; }
dest=$1; shift
case $dest in /*) : ;; *) dest=$PWD/$dest ;; esac
mkdir -p "$dest"

seen=$(mktemp 2>/dev/null || echo "$dest/.seen.$$")
: > "$seen"

have() { command -v "$1" >/dev/null 2>&1; }

copy_one() { # absolute src path (may be a symlink)
  src=$1
  [ -n "$src" ] || return 0
  case $src in
    *linux-vdso*|*libSegFault*|*vgpreload*|*/tdb/*) return 0 ;;
  esac
  real=$(readlink -f "$src" 2>/dev/null || printf '%s' "$src")
  [ -f "$real" ] || return 0
  grep -qxF "$src" "$seen" 2>/dev/null && return 0
  printf '%s\n' "$src" >> "$seen"

  dir=$dest$(dirname "$src")
  mkdir -p "$dir" 2>/dev/null || return 0
  dstf=$dir/$(basename "$src")
  # the staged tree may already hold a busybox symlink (tar, mount, e2fsck...)
  # -> cp THROUGH that symlink would destroy the real busybox. Remove it first.
  if [ -L "$dstf" ]; then rm -f "$dstf"; fi
  cp -p "$real" "$dstf" 2>/dev/null ||
    cp "$real" "$dstf" 2>/dev/null || return 0
  chmod 755 "$dstf" 2>/dev/null || true

  # the canonical location should exist too (ld.so refers via /lib64)
  if [ "$real" != "$src" ] && [ -e "$real" ]; then
    rdir=$dest$(dirname "$real")
    rdstdir="$rdir/$(basename "$real")"
    mkdir -p "$rdir" 2>/dev/null || true
    if [ ! -e "$rdstdir" ] || [ -L "$rdstdir" ]; then
      rm -f "$rdstdir" 2>/dev/null || true
      cp -p "$real" "$rdstdir" 2>/dev/null || true
    fi
  fi

  if have ldd; then
    ldd "$real" 2>/dev/null |
      awk '$1 ~ /^\// {print $1; next} $2 == "=>" && $3 ~ /^\// {print $3}' |
      while read -r lib; do
        [ -n "$lib" ] || continue
        copy_one "$lib" || true
      done
  fi
  return 0
}

for b in "$@"; do
  case $b in
    /*) src=$b ;;
    *)  src=$(ls -1 "/usr/bin/$b" "/bin/$b" "/usr/sbin/$b" "/sbin/$b" 2>/dev/null | head -1) ;;
  esac
  if [ -z "${src:-}" ] || [ ! -e "$src" ]; then
    echo "  ! not on host, skipping: $b" >&2
    continue
  fi
  echo "  + $b"
  copy_one "$src"
done

# the dynamic loader is always needed
for ld in /lib64/ld-linux-x86-64.so.2 /lib/ld-linux-aarch64.so.1 /lib/ld-linux.so.2; do
  [ -e "$ld" ] && copy_one "$ld"
done

rm -f "$seen"
exit 0
