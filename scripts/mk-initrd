#!/bin/sh
# pk's OS :: initramfs -> build/work/iso/boot/pk-initrd
#   /init            init/init
#   /bin/busybox     static busybox + all applet symlinks
#   /mods/NN-x.ko    boot modules (dependency order, uncompressed -> busybox insmod will run)
#   /sbin/blkid      for root=UUID/PARTUUID resolving
# shellcheck shell=sh disable=SC3030,SC2086
set -eu
PK_ROOT=$(cd "$(dirname "$0")/.." && pwd); export PK_ROOT
# shellcheck disable=SC1091
. "$PK_ROOT/scripts/pk.sh"

IR=$WORK/initrd
OUT=$WORK/iso/boot/pk-initrd
have cpio  || die "cpio missing -> sudo apt install cpio"
have gzip  || die "gzip missing"
resolve_kernel

BUSYBOX=${PK_BUSYBOX:-}
if [ -z "$BUSYBOX" ]; then
  for c in /bin/busybox /usr/bin/busybox /bin/busybox.static /usr/bin/busybox-static; do
    [ -x "$c" ] || continue
    if ! ldd "$c" 2>/dev/null | grep -q '=> /'; then BUSYBOX=$c; break; fi
    [ -z "$BUSYBOX" ] && BUSYBOX=$c
  done
fi
[ -n "$BUSYBOX" ] || die "static busybox not found -> sudo apt install busybox-static"
# no libc goes into the initrd -> /init fails with dynamic busybox and
# you get a kernel panic (totally blank screen). So either static is needed, or
# the WHOLE lib closure must be copied into the initrd (PK_ALLOW_DYNAMIC_BUSYBOX=1).
if ldd "$BUSYBOX" 2>/dev/null | grep -q '=> /'; then
  if [ "${PK_ALLOW_DYNAMIC_BUSYBOX:-0}" != 1 ]; then
    die "$BUSYBOX is dynamic (no libc in initrd -> /init panic). Fix: sudo apt-get install -y busybox-static , or pass PK_BUSYBOX=<static-path>, or wisely set PK_ALLOW_DYNAMIC_BUSYBOX=1 (then the lib closure gets copied itself)"
  fi
  warn "dynamic busybox is being used -> copying its lib closure into the initrd"
  BUSYBOX_DYNAMIC=1
else
  BUSYBOX_DYNAMIC=0
fi

log "initrd staging: $IR"
wipe "$IR"
for d in bin sbin dev proc sys run mods mnt etc newroot ro tmp; do mkdir -p "$IR/$d"; done
install -m 0755 "$BUSYBOX" "$IR/bin/busybox"
if [ "${BUSYBOX_DYNAMIC:-0}" = 1 ]; then
  ldd "$BUSYBOX" 2>/dev/null | awk '/=> \//{print $3}' | while read -r l; do
    [ -f "$l" ] || continue
    d=$(dirname "$l"); mkdir -p "$IR$d" 2>/dev/null
    cp -pL "$l" "$IR$l" 2>/dev/null || true
  done
  for ld in $(ls /lib64/ld-linux-x86-64.so.2 /lib/ld-linux-aarch64.so.1 2>/dev/null | head -1); do
    [ -f "$ld" ] || continue; mkdir -p "$IR$(dirname "$ld")"; cp -pL "$ld" "$IR$ld" 2>/dev/null || true
  done
fi
"$IR/bin/busybox" --list | while read -r app; do
  case "$app" in ''|*/*) continue ;; esac
  for d in bin sbin; do
    t=$IR/$d/$app
    [ -e "$t" ] || [ -L "$t" ] || ln -sf /bin/busybox "$t"
  done
done
install -m 0755 "$PK_ROOT/init/init" "$IR/init"

# ---------------------------------------------------------------- modules
if [ -d "$PK_MODULES" ] && [ -f "$PK_ROOT/init/kernel-modules" ]; then
  log "boot modules (dependency closure) copy..."
  i=10
  modseen=$WORK/.initrd-modseen; : > "$modseen"
  : > "$WORK/initrd-modules.log"
  for name in $(grep -vE '^[[:space:]]*(#|$)' "$PK_ROOT/init/kernel-modules"); do
    if grep -qx "$name" "$PK_MODULES/modules.builtin" 2>/dev/null; then
      echo "  = $name (built-in)" >> "$WORK/initrd-modules.log"; continue
    fi
    if have modprobe && modprobe --set-version "$KVER" --show-depends "$name" > "$IR/.dep" 2>/dev/null; then
      :
    elif have modprobe && modprobe --show-depends --set-version "$KVER" "$name" > "$IR/.dep" 2>/dev/null; then
      :
    else
      echo "insmod $PK_MODULES/kernel/**/$name.ko" > "$IR/.dep"
      f=$(find "$PK_MODULES" -name "$name.ko*" 2>/dev/null | head -1 || true)
      [ -n "$f" ] && printf 'insmod %s\n' "$f" > "$IR/.dep" || { rm -f "$IR/.dep"; continue; }
    fi
    while read -r _ ko; do
      [ -n "${ko:-}" ] || continue
      [ -f "$ko" ] || continue
      b=${ko##*/}; b=${b%.xz}; b=${b%.gz}; b=${b%.zst}; b=${b%.zstd}; b=${b%.lzma}; b=${b%.ko}
      # do NOT copy the SAME module twice (deps repeat in the modprobe closure)
      grep -qxF "$b" "$modseen" 2>/dev/null && continue
      tgt=$IR/mods/$(printf '%03d' "$i")-$b.ko
      case "$ko" in
        *.xz)   xz   -dc < "$ko" > "$tgt" ;;
        *.gz)   gzip -dc < "$ko" > "$tgt" ;;
        *.zst|*.zstd) have zstd || die "zstd missing (sudo apt install zstd) - $ko"; zstd -qc -d "$ko" > "$tgt" ;;
        *.lzma) lzma -dc < "$ko" > "$tgt" ;;
        *)      cp "$ko" "$tgt" ;;
      esac
      chmod 0644 "$tgt"
      printf '%s\n' "$b" >> "$modseen"
      i=$((i + 1))
    done < "$IR/.dep"
    rm -f "$IR/.dep"
  done
  log "  $(ls "$IR/mods" 2>/dev/null | wc -l) modules in /mods"
else
  warn "modules dir not found -> initrd without /mods (kernel must have all built-in)"
fi

# ---------------------------------------------------------------- blkid (root= resolve)
if [ -x "$PK_ROOT/scripts/collect-bins" ]; then
  "$PK_ROOT/scripts/collect-bins" "$IR" blkid 2>/dev/null | grep -v '^  skip' || true
  for p in "$IR/usr/sbin/blkid" "$IR/sbin/blkid" "$IR/bin/blkid"; do
    [ -e "$p" ] || continue
    ln -sfn "${p#$IR}" "$IR/sbin/blkid" 2>/dev/null
    ln -sfn "${p#$IR}" "$IR/bin/blkid"  2>/dev/null
    break
  done
fi
# the loader needs the /lib64 path too
[ -d "$IR/lib" ] || ln -sfn usr/lib "$IR/lib" 2>/dev/null || mkdir -p "$IR/lib"

# ---------------------------------------------------------------- pack
mkdir -p "$(dirname "$OUT")"
# kernel initrd decompressors: see /boot/config (RD_ZSTD/RD_XZ/RD_LZ4...)
icomp=${INITRD_COMP:-auto}
cfg=/boot/config-$KVER
pick() { # <comp> -> 0 if the kernel supports it and the tool exists
  case $1 in
    zstd) have zstd || return 1; key=RD_ZSTD ;;
    xz)   have xz   || return 1; key=RD_XZ   ;;
    lz4)  have lz4  || return 1; key=RD_LZ4  ;;
    *)    key=RD_GZIP ;;
  esac
  [ -r "$cfg" ] || return 0        # if no config, trust kernel defaults
  grep -qE "^CONFIG_$key=y" "$cfg"
}
if [ "$icomp" = auto ]; then
  for c in xz gzip; do
    if pick "$c"; then icomp=$c; break; fi
  done
  [ -n "$icomp" ] || icomp=gzip
  [ "$icomp" = auto ] && icomp=gzip
fi
if ! pick "$icomp"; then warn "$icomp initrd in support not -> gzip"; icomp=gzip; fi
pack() {
  case $icomp in
    xz)   xz -9 --check=crc32 -T0 ;;
    lz4)  lz4 -12 -q ;;
    zstd) zstd -19 -T0 -q ;;
    *)    gzip -9n ;;
  esac
}
log "packing (cpio + $icomp)..."
normalize_tree "$IR"
cpioopt=""
if cpio --help 2>&1 | grep -q -- '--reproducible'; then cpioopt="--reproducible"; fi
if [ -n "${SOURCE_DATE_EPOCH:-}" ]; then
  log "  reproducible: mtime = @$SOURCE_DATE_EPOCH, sorted cpio $cpioopt"
  find "$IR" -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} + 2>/dev/null || true
fi
( cd "$IR" && LC_ALL=C find . -print0 | LC_ALL=C sort -z | LC_ALL=C cpio --null -o -H newc -R 0:0 $cpioopt 2>/dev/null ) | pack > "$OUT"
log "  -> $OUT ($(du -h "$OUT" | cut -f1))"
