#!/bin/sh
# pk's OS :: build/work/rootfs -> build/work/iso/live/pk.sqfs
# shellcheck shell=sh disable=SC3030,SC2086
set -eu
PK_ROOT=$(cd "$(dirname "$0")/.." && pwd); export PK_ROOT
# shellcheck disable=SC1091
. "$PK_ROOT/scripts/pk.sh"

OV=$WORK/rootfs
IMG=$WORK/iso/live/pk.sqfs
[ -d "$OV" ] || die "first: scripts/build-rootfs (or make live)"
have mksquashfs || die "mksquashfs missing -> sudo apt install squashfs-tools"
resolve_kernel

# kernel kis compression ko unpack kar sakta hai? /boot/config se pata karo
cfg=/boot/config-$KVER
comp=${SQUASH_COMP:-auto}
if [ "$comp" = auto ]; then
  for c in zstd xz lz4 gzip; do
    key=ZSTD; case $c in xz) key=XZ;; lz4) key=LZ4;; gzip) key=ZLIB;; esac
    if [ ! -r "$cfg" ]; then comp=$c; break; fi
    if grep -qE "^CONFIG_SQUASHFS_$key=y" "$cfg"; then comp=$c; break; fi
  done
  [ -n "$comp" ] || { warn "$cfg in any SQUASHFS_*=y not -> gzip"; comp=gzip; }
  [ -r "$cfg" ] || log "note: $cfg not found, $comp use run hoon"
fi
mkdir -p "$(dirname "$IMG")"
rm -f "$IMG"
# reproducible builds: SOURCE_DATE_EPOCH set ho to squashfs ke timestamps fix karo
epochopt=""
if [ -n "${SOURCE_DATE_EPOCH:-}" ]; then
  # squashfs-tools 4.4+ SOURCE_DATE_EPOCH ko KHUD honor karta hai; -mkfs-time bhi
  # do to "can't be used at the same time" se fatal -> version dekh ke hi flag do
  ver=$( { mksquashfs -version 2>/dev/null; mksquashfs --version 2>/dev/null; } \
         | sed -n 's/.*version \([0-9]*\.[0-9]*\).*$/\1/p' | head -1)
  case "$ver" in
    4.[4-9]*|4.1[0-9]*|5.*)  log " reproducible: mksquashfs $ver SOURCE_DATE_EPOCH khud use uses" ;;
    "")                      log " reproducible: version parse not hui - env hi kaam karega" ;;
    *)   if mksquashfs -help 2>&1 | grep -q 'all-time'; then
           epochopt="-all-time $SOURCE_DATE_EPOCH -mkfs-time $SOURCE_DATE_EPOCH"
           log "  reproducible: -all-time/-mkfs-time = @$SOURCE_DATE_EPOCH (mksquashfs $ver)"
         else
           warn " mksquashfs $ver in timestamp fix to run option not -> payload reproducible not will"
         fi ;;
  esac
fi
log "squashfs (-comp $comp, -all-root, 1MiB blocks)..."
if ! mksquashfs "$OV" "$IMG" -comp "$comp" -b 1048576 -noappend -all-root $epochopt \
     > "$WORK/squashfs.log" 2>&1; then
  tail -3 "$WORK/squashfs.log" || true
  warn "$comp fail -> xz try"
  mksquashfs "$OV" "$IMG" -comp xz -b 1048576 -noappend -all-root $epochopt >> "$WORK/squashfs.log" 2>&1 \
    || die "mksquashfs fail (log: $WORK/squashfs.log)"
fi
grep -E "Exportable|Total bytes read|Compression" "$WORK/squashfs.log" | head -4 | sed 's/^/    /'
log "  -> $IMG  ($(du -h "$IMG" | cut -f1))"
